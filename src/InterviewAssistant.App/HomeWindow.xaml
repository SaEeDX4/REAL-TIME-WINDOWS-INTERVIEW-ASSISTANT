<Window x:Class="InterviewAssistant.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:InterviewAssistant.App.Views"
        Title="Interview Assistant" Width="1040" Height="720" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="True"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True" FlowDirection="{v:LocFlow}">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="{StaticResource S.SectionMargin}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level1"/>
            <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="{StaticResource S.HintMargin}"/>
        </Style>
        <Style x:Key="AboutKey" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,3,16,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="AboutValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="List" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource B.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ListItem.Row}"/>
        </Style>
        <!-- Account dashboard: card heading and the gap between stacked cards -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,10"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <Thickness x:Key="S.CardGap">0,0,0,16</Thickness>
        <!-- a page that fills the visible height of the content area (minus the page's bottom margin) -->
        <v:Offset x:Key="FillViewport" By="-8"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid Background="#01000000">
    <Border x:Name="HomeRoot" Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8" Effect="{StaticResource E.Shadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.ColumnSpan="2" Margin="18,12,10,6" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    <Button x:Name="AccountBadge" Style="{StaticResource Btn.Ghost}" Margin="12,2,0,0" Padding="8,3" FontSize="12" Click="AccountBadge_Click" MaxWidth="320"
                            ToolTip="{v:Loc tt_open_account}" AutomationProperties.Name="{v:Loc account}">
                        <TextBlock x:Name="AccountBadgeText" TextTrimming="CharacterEllipsis"/>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HeaderSignOutBtn" Style="{StaticResource Btn.Ghost}" Click="SignOut_Click" Margin="0,0,8,0" Padding="10,4"
                            ToolTip="{v:Loc tt_sign_out}" AutomationProperties.Name="{v:Loc sign_out}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE748;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{v:Loc sign_out}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Click="Minimize_Click" ToolTip="{v:Loc tt_minimize}" AutomationProperties.Name="{v:Loc tt_minimize}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE921;" FontSize="11"/></Button>
                    <Button Style="{StaticResource Btn.Ghost}" Click="Maximize_Click" ToolTip="{v:Loc tt_maximize}" AutomationProperties.Name="{v:Loc tt_maximize}"><TextBlock x:Name="MaxIcon" Style="{StaticResource T.Icon}" Text="&#xE922;" FontSize="11"/></Button>
                    <Button Style="{StaticResource Btn.Ghost}" Click="Close_Click" ToolTip="{v:Loc tt_close_home}" AutomationProperties.Name="{v:Loc tt_close_home}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
                </StackPanel>
            </Grid>

            <!-- navigation -->
            <StackPanel Grid.Row="1" Margin="12,8,8,12">
                <Button x:Name="NavStart" Style="{StaticResource Nav}" Click="Nav_Click" Tag="start" Content="{v:Loc nav_start}"/>
                <Button x:Name="NavProfiles" Style="{StaticResource Nav}" Click="Nav_Click" Tag="profiles" Content="{v:Loc profiles}"/>
                <Button x:Name="NavInterviews" Style="{StaticResource Nav}" Click="Nav_Click" Tag="interviews" Content="{v:Loc interviews}"/>
                <Button x:Name="NavReports" Style="{StaticResource Nav}" Click="Nav_Click" Tag="reports" Content="{v:Loc reports}"/>
                <Button x:Name="NavAccount" Style="{StaticResource Nav}" Click="Nav_Click" Tag="account" Content="{v:Loc account}"/>
                <Button x:Name="NavSettings" Style="{StaticResource Nav}" Click="Nav_Click" Tag="settings" Content="{v:Loc settings}"/>
                <Button x:Name="NavHelp" Style="{StaticResource Nav}" Click="Nav_Click" Tag="help" Content="{v:Loc nav_help}"/>
                <Border Height="1" Background="{StaticResource B.Border}" Margin="6,12"/>
                <TextBlock Text="{v:Loc ui_language}" Style="{StaticResource T.Label}" Margin="12,0,0,6"/>
                <ComboBox x:Name="UiLanguageBox" Margin="6,0" SelectionChanged="UiLanguage_Changed" DisplayMemberPath="DisplayName"
                          ToolTip="{v:Loc tt_ui_language}" AutomationProperties.Name="{v:Loc ui_language}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="12,6,6,0" FontSize="11" Text="{v:Loc ui_language_hint}"/>
            </StackPanel>

            <!-- content -->
            <DockPanel Grid.Row="1" Grid.Column="1" Margin="8,8,8,12">
            <!-- Settings: sticky save bar (explicit Save; shows when there are unsaved changes) -->
            <Border x:Name="SettingsFooter" DockPanel.Dock="Bottom" Visibility="Collapsed" Margin="8,8,16,0" Padding="14,8" CornerRadius="{StaticResource R.Card}"
                    Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="SettingsDiscardBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc dlg_discard}" Click="SettingsDiscard_Click" Margin="0,0,8,0"/>
                        <Button x:Name="SettingsSaveBtn" Style="{StaticResource Btn.FormPrimary}" Content="{v:Loc dlg_save}" Click="SettingsSave_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="SettingsDirtyDot" Width="8" Height="8" Fill="{StaticResource B.Thinking}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SettingsDirtyText" Style="{StaticResource T.Body}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto">
                <!-- pages fill the width up to the content maximum, starting at the reading-order start (left in LTR, right in RTL) -->
                <Grid Margin="{StaticResource S.PageMargin}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource S.ContentMaxWidth}"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>

                    <!-- ===== Get started ===== -->
                    <StackPanel x:Name="PageStart" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{v:Loc start_title}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{v:Loc start_subtitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step1Title" Style="{StaticResource T.Label}"/>
                                <CheckBox x:Name="AckBox" Style="{StaticResource Check}" Margin="0,8,0,0" Checked="Ack_Changed" Unchecked="Ack_Changed">
                                    <TextBlock Text="{v:Loc authorized_use}" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" MaxWidth="560"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource Hint}" Text="{v:Loc start_step1_hint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step2Title" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step2Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="GoAccountBtn" Style="{StaticResource Btn.Primary}" Content="{v:Loc start_sign_in_or_create}" Click="GoAccount_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="DeveloperModeBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc start_developer_mode}" Click="DeveloperMode_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step3Title" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step3Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="StartImportBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc import_resume}" Click="NewProfile_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="StartInterviewProfileBtn" Style="{StaticResource Btn.Ghost}" Content="{v:Loc start_complete_profile}" Click="GoInterviewProfile_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step4Title" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step4Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="StartAddInterviewBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc start_add_interview}" Click="GoInterviews_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource Btn.Base}" Content="{v:Loc preflight}" Click="Readiness_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="DoneBtn" Style="{StaticResource Btn.Primary}" Content="{v:Loc start_interview}" Click="Done_Click" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="18,8"/>
                    </StackPanel>

                    <!-- ===== Profiles ===== -->
                    <Grid x:Name="PageProfiles" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource S.SidePaneWidth}"/>
                            <ColumnDefinition Width="{StaticResource S.PaneGap}"/>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource S.PageMaxWidth}"/>
                        </Grid.ColumnDefinitions>
                        <!-- list + actions: one primary, a secondary group, the destructive action last and set apart -->
                        <StackPanel x:Name="ProfileActions">
                            <TextBlock Style="{StaticResource H1}" Text="{v:Loc profiles}"/>
                            <ListBox x:Name="ProfileList" Style="{StaticResource List}" MinHeight="120" MaxHeight="300" Margin="0,8,0,8" SelectionChanged="ProfileList_SelectionChanged"
                                     AutomationProperties.Name="{v:Loc profiles}"/>
                            <TextBlock x:Name="ProfilesEmpty" Style="{StaticResource Hint}" Text="{v:Loc warn_create_profile_first}" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <Button x:Name="ImportResumeBtn" Style="{StaticResource Btn.FormPrimary}" Content="{v:Loc import_resume}" Click="NewProfile_Click" Margin="{StaticResource S.StackGap}" ToolTip="{v:Loc tt_import_resume}"/>
                            <Button x:Name="AddDocumentBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc add_document}" Click="AddResume_Click" Margin="{StaticResource S.StackGap}" ToolTip="{v:Loc tt_add_document}"/>
                            <Button x:Name="NewEmptyProfileBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc new_empty_profile}" Click="NewEmptyProfile_Click" Margin="{StaticResource S.StackGap}" ToolTip="{v:Loc tt_new_empty_profile}"/>
                            <Button x:Name="ExportProfileBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc export_ellipsis}" Click="ExportProfile_Click" ToolTip="{v:Loc tt_export_profile}"/>
                            <Border Style="{StaticResource Divider}"/>
                            <Button x:Name="DeleteProfileBtn" Style="{StaticResource Btn.FormDanger}" Content="{v:Loc delete_profile}" Click="DeleteProfile_Click" ToolTip="{v:Loc tt_delete_profile}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc profile_local_hint}" Margin="0,12,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" x:Name="ProfileDetail">
                            <!-- header fields: one grid, labels above the fields, equal columns, field height from the shared input style -->
                            <Grid x:Name="ProfileHeaderGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{StaticResource S.ColumnGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="ProfileNameLabel" Text="{v:Loc profile_name}" Style="{StaticResource T.FieldLabel}"/>
                                <TextBox x:Name="ProfileName" Grid.Row="1" TextChanged="ProfileField_Changed" AutomationProperties.Name="{v:Loc profile_name}"/>
                                <TextBlock Grid.Column="2" Text="{v:Loc profile_preferred_name}" Style="{StaticResource T.FieldLabel}"/>
                                <TextBox x:Name="ProfilePreferred" Grid.Row="1" Grid.Column="2" TextChanged="ProfileField_Changed" AutomationProperties.Name="{v:Loc profile_preferred_name}"/>
                                <TextBlock Grid.Row="2" Grid.ColumnSpan="3" Text="{v:Loc profile_headline}" Style="{StaticResource T.FieldLabel}"/>
                                <TextBox x:Name="ProfileHeadline" Grid.Row="3" Grid.ColumnSpan="3" TextChanged="ProfileField_Changed" AutomationProperties.Name="{v:Loc profile_headline}"/>
                            </Grid>

                            <!-- section switch: two equal segments across the content width (Tab focuses the selected one, Left/Right switch) -->
                            <Border Style="{StaticResource Seg.Track}" Margin="0,24,0,0">
                                <UniformGrid x:Name="ProfileTabs" Rows="1" PreviewKeyDown="ProfileTabs_PreviewKeyDown" AutomationProperties.Name="{v:Loc profile_sections}">
                                    <RadioButton x:Name="TabFacts" Style="{StaticResource Seg.Item}" GroupName="ProfileSection" Tag="facts" Content="{v:Loc profile_tab_facts}"
                                                 ToolTip="{v:Loc profile_tab_facts}" AutomationProperties.Name="{v:Loc profile_tab_facts}" Checked="ProfileTab_Checked"/>
                                    <RadioButton x:Name="TabPersonal" Style="{StaticResource Seg.Item}" GroupName="ProfileSection" Tag="personal" Content="{v:Loc profile_tab_personal}"
                                                 ToolTip="{v:Loc profile_tab_personal}" AutomationProperties.Name="{v:Loc profile_tab_personal}" Checked="ProfileTab_Checked"/>
                                </UniformGrid>
                            </Border>

                            <!-- facts -->
                            <StackPanel x:Name="FactsPanel">
                                <DockPanel Margin="0,16,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Btn.Form}" Content="{v:Loc fact_add}" Click="AddFact_Click" Margin="8,0,0,0" ToolTip="{v:Loc tt_fact_add}"/>
                                        <Button Style="{StaticResource Btn.Form}" Content="{v:Loc confirm_all}" Click="ConfirmAll_Click" Margin="8,0,0,0" ToolTip="{v:Loc tt_confirm_all}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FactsHeader" Style="{StaticResource T.Label}" Margin="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8" Text="{v:Loc facts_hint}"/>
                                <DockPanel Margin="0,2,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button x:Name="FilterAll" Style="{StaticResource Btn.Chip}" Content="{v:Loc filter_all}" Tag="all" Click="FactFilter_Click"/>
                                        <Button x:Name="FilterReview" Style="{StaticResource Btn.Chip}" Content="{v:Loc filter_review}" Tag="review" Click="FactFilter_Click"/>
                                        <Button x:Name="FilterConfirmed" Style="{StaticResource Btn.Chip}" Content="{v:Loc filter_confirmed}" Tag="confirmed" Click="FactFilter_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FactSummary" FontSize="11.5" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <ItemsControl x:Name="FactList" AutomationProperties.Name="{v:Loc profile_tab_facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" IsChecked="{Binding Confirmed, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                              ToolTip="{v:Loc tt_fact_confirm}" AutomationProperties.Name="{Binding Text}"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                                        <Button Style="{StaticResource Btn.Ghost}" Padding="6,2" Click="EditFact_Click" Tag="{Binding}" ToolTip="{v:Loc tt_fact_edit}" AutomationProperties.Name="{v:Loc tt_fact_edit}">
                                                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE70F;" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource Btn.Ghost}" Padding="6,2" Click="DeleteFact_Click" Tag="{Binding}" ToolTip="{v:Loc tt_fact_delete}" AutomationProperties.Name="{v:Loc tt_fact_delete}">
                                                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE74D;" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Meta}" TextWrapping="Wrap" Foreground="{StaticResource B.TextFaint}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="FactsEmpty" Style="{StaticResource Hint}" Text="{v:Loc facts_empty}" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- interview profile (personal) -->
                            <StackPanel x:Name="PersonalPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,4" Text="{v:Loc personal_intro}"/>
                                <StackPanel x:Name="PersonalFields"/>
                            </StackPanel>

                            <v:InlineMessage x:Name="ProfileMessage" Margin="0,12,0,0"/>
                            <WrapPanel Margin="{StaticResource S.ButtonRowMargin}">
                                <Button x:Name="SaveProfileBtn" Style="{StaticResource Btn.FormPrimary}" Content="{v:Loc save_profile}" Click="SaveProfile_Click" Margin="{StaticResource S.ButtonGap}"/>
                                <TextBlock x:Name="ProfileDirty" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" Foreground="{StaticResource B.Thinking}" AutomationProperties.LiveSetting="Polite"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Interviews (same grid and action pattern as Profiles) ===== -->
                    <Grid x:Name="PageInterviews" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource S.SidePaneWidth}"/>
                            <ColumnDefinition Width="{StaticResource S.PaneGap}"/>
                            <ColumnDefinition Width="*" MaxWidth="{StaticResource S.PageMaxWidth}"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="InterviewActions">
                            <TextBlock Style="{StaticResource H1}" Text="{v:Loc interviews}"/>
                            <TextBlock x:Name="InterviewsProfile" Style="{StaticResource Hint}"/>
                            <ListBox x:Name="TargetList" Style="{StaticResource List}" MinHeight="120" MaxHeight="300" Margin="0,8,0,8" SelectionChanged="TargetList_SelectionChanged" AutomationProperties.Name="{v:Loc interviews}"/>
                            <TextBlock x:Name="InterviewsEmpty" Style="{StaticResource Hint}" Text="{v:Loc interviews_empty}" Margin="0,0,0,8" Visibility="Collapsed"/>
                            <Button x:Name="NewTargetBtn" Style="{StaticResource Btn.FormPrimary}" Content="{v:Loc new_interview}" Click="NewTarget_Click"/>
                            <Border Style="{StaticResource Divider}"/>
                            <Button x:Name="DeleteTargetBtn" Style="{StaticResource Btn.FormDanger}" Content="{v:Loc delete_interview}" Click="DeleteTarget_Click" ToolTip="{v:Loc tt_delete_interview}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" x:Name="TargetDetail">
                            <Grid x:Name="TargetFieldGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="{StaticResource S.ColumnGap}"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="{v:Loc job_title}" Style="{StaticResource T.FieldLabel}"/>
                                <TextBox x:Name="TargetTitle" Grid.Row="1" TextChanged="TargetField_Changed" AutomationProperties.Name="{v:Loc job_title}"/>
                                <TextBlock Grid.Column="2" Text="{v:Loc company}" Style="{StaticResource T.FieldLabel}"/>
                                <TextBox x:Name="TargetCompany" Grid.Row="1" Grid.Column="2" TextChanged="TargetField_Changed" AutomationProperties.Name="{v:Loc company}"/>
                                <TextBlock Grid.Row="2" Text="{v:Loc interview_language}" Style="{StaticResource T.FieldLabel}"/>
                                <ComboBox x:Name="TargetLanguage" Grid.Row="3" SelectionChanged="TargetField_Changed" AutomationProperties.Name="{v:Loc interview_language}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{v:Loc answer_language}" Style="{StaticResource T.FieldLabel}"/>
                                <ComboBox x:Name="TargetAnswerLanguage" Grid.Row="3" Grid.Column="2" SelectionChanged="TargetField_Changed" AutomationProperties.Name="{v:Loc answer_language}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc language_separation_hint}"/>
                            <DockPanel Margin="0,12,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Form}" Content="{v:Loc import_file}" Click="ImportJd_Click" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
                                <TextBlock Text="{v:Loc job_description}" Style="{StaticResource T.FieldLabel}" Margin="0,0,0,2" VerticalAlignment="Bottom"/>
                            </DockPanel>
                            <TextBox x:Name="TargetJd" Style="{StaticResource Input.Multiline}" Height="170" TextChanged="TargetField_Changed"
                                     AutomationProperties.Name="{v:Loc job_description}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc documents_are_data}"/>
                            <v:InlineMessage x:Name="TargetMessage"/>
                            <!-- action bar: primary first, then the secondary actions, state text last -->
                            <WrapPanel Margin="{StaticResource S.ButtonRowMargin}">
                                <Button x:Name="PrepareBtn" Style="{StaticResource Btn.FormPrimary}" Content="{v:Loc prepare}" Click="Prepare_Click" Margin="{StaticResource S.ButtonGap}"/>
                                <Button x:Name="SaveTargetBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc save}" Click="SaveTarget_Click" Margin="{StaticResource S.ButtonGap}" ToolTip="{v:Loc tt_save_interview}"/>
                                <Button x:Name="UseBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc start_interview}" Click="UseTarget_Click" Margin="{StaticResource S.ButtonGap}"/>
                                <TextBlock x:Name="TargetDirty" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" Foreground="{StaticResource B.Thinking}" AutomationProperties.LiveSetting="Polite"/>
                            </WrapPanel>
                            <ProgressBar x:Name="PrepProgress" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Foreground="{StaticResource B.Accent}" Background="{StaticResource B.Surface3}" BorderThickness="0"/>
                            <TextBlock x:Name="PrepStatus" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="PrepSummary" Style="{StaticResource Hint}" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Reports: list (≈1/3, min 260) and preview (≈2/3); fills the visible height, mirrors in RTL ===== -->
                    <Grid x:Name="PageReports" Visibility="Collapsed" MinHeight="420"
                          Height="{Binding ViewportHeight, ElementName=ContentScroll, Converter={StaticResource FillViewport}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource H1}" Text="{v:Loc reports}"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource Hint}" Text="{v:Loc reports_hint}"/>

                        <Grid x:Name="ReportsBody" Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32*" MinWidth="{StaticResource S.PaneMinWidth}"/>
                                <ColumnDefinition Width="{StaticResource S.PaneGap}"/>
                                <ColumnDefinition Width="68*" MinWidth="{StaticResource S.PaneMinWidth}"/>
                            </Grid.ColumnDefinitions>
                            <!-- Up/Down select, Enter opens, Delete asks to delete -->
                            <ListBox x:Name="ReportList" Style="{StaticResource List}" MouseDoubleClick="OpenReport_Click" KeyDown="ReportList_KeyDown"
                                     SelectionChanged="ReportList_SelectionChanged" AutomationProperties.Name="{v:Loc reports}" AutomationProperties.HelpText="{v:Loc tt_report_list}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding When}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource B.TextDim}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Title}"/>
                                            <TextBlock Text="{Binding Questions}" FontSize="11.5" Foreground="{StaticResource B.TextFaint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="ReportPane" Grid.Column="2" Style="{StaticResource Card}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <!-- actions for the selected report: secondary group, destructive set apart at the end -->
                                    <DockPanel x:Name="ReportToolbar" Margin="0,0,0,8" AutomationProperties.Name="{v:Loc report_actions}">
                                        <Button x:Name="DeleteReportBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.FormDanger}" Content="{v:Loc delete}" Click="DeleteReport_Click"
                                                ToolTip="{v:Loc tt_delete_report}" Margin="0,0,0,8" VerticalAlignment="Top"/>
                                        <Border DockPanel.Dock="Right" Width="1" Height="24" Background="{StaticResource B.Border}" Margin="4,6,12,8" VerticalAlignment="Top"/>
                                        <WrapPanel>
                                            <Button x:Name="OpenReportBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc open}" Click="OpenReport_Click" Margin="{StaticResource S.ButtonGap}" ToolTip="{v:Loc tt_open_report}"/>
                                            <Button x:Name="CopyReportBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc copy_as_text}" Click="CopyReport_Click" Margin="{StaticResource S.ButtonGap}" ToolTip="{v:Loc tt_copy_report}"/>
                                            <Button x:Name="ExportReportBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc save_as_html}" Click="ExportReport_Click" Margin="{StaticResource S.ButtonGap}" ToolTip="{v:Loc tt_save_report_html}"/>
                                        </WrapPanel>
                                    </DockPanel>
                                    <!-- summary of the selected report -->
                                    <ScrollViewer x:Name="ReportPreview" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <StackPanel>
                                            <Border Style="{StaticResource Divider}" Margin="0,0,0,12"/>
                                            <TextBlock x:Name="ReportPreviewTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="ReportPreviewMeta" Style="{StaticResource Hint}"/>
                                            <TextBlock x:Name="ReportPreviewQuestions" Style="{StaticResource T.Body}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <!-- nothing selected -->
                                    <StackPanel x:Name="ReportSelectState" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320" Margin="0,24">
                                        <Border Style="{StaticResource EmptyState.Icon}">
                                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8FD;" FontSize="22" Foreground="{StaticResource B.TextDim}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource T.EmptyTitle}" Text="{v:Loc reports_select_title}"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{v:Loc reports_select_hint}" TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- no reports at all -->
                        <Border x:Name="ReportsEmptyState" Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360" Margin="0,24">
                                <Border Style="{StaticResource EmptyState.Icon}">
                                    <TextBlock Style="{StaticResource T.Icon}" Text="&#xE9F9;" FontSize="22" Foreground="{StaticResource B.TextDim}" HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Style="{StaticResource T.EmptyTitle}" Text="{v:Loc reports_empty_title}"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{v:Loc reports_empty_hint}" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Help & about ===== -->
                    <StackPanel x:Name="PageHelp" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{v:Loc nav_help}"/>
                        <TextBlock Text="{v:Loc help_getting_started}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_getting_started_body}"/>
                        <TextBlock Text="{v:Loc help_before}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_before_body}"/>
                        <TextBlock Text="{v:Loc help_controls}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_controls_body}"/>
                        <TextBlock Text="{v:Loc help_audio}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_audio_body}"/>
                        <TextBlock Text="{v:Loc help_honesty}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_honesty_body}"/>
                        <TextBlock Text="{v:Loc help_about}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid x:Name="AboutGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="140" MaxWidth="260"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource AboutKey}" Text="{v:Loc about_product}"/>
                                <TextBlock x:Name="AboutProduct" Grid.Column="1" Style="{StaticResource AboutValue}"/>
                                <TextBlock Grid.Row="1" Style="{StaticResource AboutKey}" Text="{v:Loc about_version}"/>
                                <TextBlock x:Name="AboutVersion" Grid.Row="1" Grid.Column="1" Style="{StaticResource AboutValue}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="2" Style="{StaticResource AboutKey}" Text="{v:Loc about_channel}"/>
                                <TextBlock x:Name="AboutChannel" Grid.Row="2" Grid.Column="1" Style="{StaticResource AboutValue}"/>
                                <TextBlock Grid.Row="3" Style="{StaticResource AboutKey}" Text="{v:Loc about_build}"/>
                                <TextBlock x:Name="AboutBuild" Grid.Row="3" Grid.Column="1" Style="{StaticResource AboutValue}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="4" Style="{StaticResource AboutKey}" Text="{v:Loc about_install}"/>
                                <TextBlock x:Name="AboutInstall" Grid.Row="4" Grid.Column="1" Style="{StaticResource AboutValue}"/>
                                <TextBlock Grid.Row="5" Style="{StaticResource AboutKey}" Text="{v:Loc about_signing}"/>
                                <TextBlock x:Name="AboutSigning" Grid.Row="5" Grid.Column="1" Style="{StaticResource AboutValue}"/>
                                <TextBlock Grid.Row="6" Style="{StaticResource AboutKey}" Text="{v:Loc about_service}"/>
                                <TextBlock x:Name="AboutService" Grid.Row="6" Grid.Column="1" Style="{StaticResource AboutValue}"/>
                            </Grid>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource Btn.Base}" Content="{v:Loc copy_build_info}" Click="CopyBuildInfo_Click" Margin="0,0,8,0" ToolTip="{v:Loc tt_copy_build_info}"/>
                            <Button Style="{StaticResource Btn.Base}" Content="{v:Loc open_log_folder}" Click="OpenLogs_Click" ToolTip="{v:Loc tt_logs}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ===== Account ===== -->
                    <StackPanel x:Name="PageAccount" Visibility="Collapsed" MaxWidth="{StaticResource S.ContentMaxWidth}">
                        <TextBlock x:Name="AccountTitle" Style="{StaticResource H1}" Text="{v:Loc account}"/>
                        <!-- account-wide state only (signed in as …, connecting, update required); request failures are shown in their own section -->
                        <TextBlock x:Name="AccountStatus" Style="{StaticResource Hint}" Foreground="{StaticResource B.TextDim}" FontSize="13" AutomationProperties.LiveSetting="Polite"/>

                        <!-- signed out: e-mail + password -->
                        <Border x:Name="SignedOutPanel" Style="{StaticResource Card}" Margin="0,12,0,0" MaxWidth="460" HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="ModeSignInBtn" Style="{StaticResource Btn.Chip}" Content="{v:Loc sign_in}" Click="ModeSignIn_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="ModeCreateBtn" Style="{StaticResource Btn.Chip}" Content="{v:Loc create_account}" Click="ModeCreate_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="EmailLabel" Text="{v:Loc email}" Style="{StaticResource T.FieldLabel}"/>
                                <TextBox x:Name="EmailBox" AutomationProperties.Name="{v:Loc email}" TabIndex="1" FlowDirection="LeftToRight" KeyDown="Email_KeyDown"/>
                                <TextBlock x:Name="PasswordLabel" Text="{v:Loc password}" Style="{StaticResource T.FieldLabel}"/>
                                <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="{v:Loc password}" TabIndex="2" KeyDown="Password_KeyDown" FlowDirection="LeftToRight"/>
                                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                                    <TextBlock Text="{v:Loc confirm_password}" Style="{StaticResource T.FieldLabel}"/>
                                    <PasswordBox x:Name="ConfirmBox" AutomationProperties.Name="{v:Loc confirm_password}" TabIndex="3" KeyDown="Password_KeyDown" FlowDirection="LeftToRight"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{v:Loc password_rules}"/>
                                    <TextBlock x:Name="SignUpLegal" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <!-- the form's own result: errors right under the fields, reset and confirmation notices -->
                                <v:InlineMessage x:Name="AuthMessage" Margin="0,12,0,0"/>
                                <WrapPanel Margin="{StaticResource S.ButtonRowMargin}">
                                    <Button x:Name="AuthSubmitBtn" Style="{StaticResource Btn.FormPrimary}" Content="{v:Loc sign_in}" Click="AuthSubmit_Click" Margin="0,0,10,8" TabIndex="4" MinWidth="120"/>
                                    <Button x:Name="ForgotBtn" Style="{StaticResource Btn.Ghost}" Content="{v:Loc forgot_password}" Click="Forgot_Click" TabIndex="5" Margin="0,0,0,8"/>
                                </WrapPanel>
                                <WrapPanel x:Name="ProviderButtons" Margin="0,2,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{v:Loc password_privacy_hint}"/>
                            </StackPanel>
                        </Border>

                        <!-- signed in: a responsive dashboard (two columns on wide content, one below ~900 px). Every card loads
                             and reports independently: a failed request is shown in its own card, next to the data it concerns. -->
                        <Grid x:Name="SignedInPanel" Margin="0,12,0,0" SizeChanged="AccountDashboard_SizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="AccountColMain" Width="3*"/>
                                <ColumnDefinition x:Name="AccountColGap" Width="{StaticResource S.PaneGap}"/>
                                <ColumnDefinition x:Name="AccountColSide" Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                            <StackPanel x:Name="AccountMainColumn">
                                <!-- Plan & usage -->
                                <Border Style="{StaticResource Card}" Margin="{StaticResource S.CardGap}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="RefreshAccountBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Click="RefreshAccount_Click" ToolTip="{v:Loc tt_refresh_account}"
                                                    AutomationProperties.Name="{v:Loc refresh}" VerticalAlignment="Top" Margin="8,-4,-6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource T.Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{v:Loc refresh}"/>
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="{v:Loc acct_card_plan}" Style="{StaticResource CardTitle}"/>
                                        </DockPanel>
                                        <WrapPanel>
                                            <TextBlock x:Name="PlanText" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Border x:Name="PlanBadge" CornerRadius="10" Padding="9,2" BorderThickness="1" VerticalAlignment="Center" Visibility="Collapsed">
                                                <TextBlock x:Name="PlanBadgeText" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock x:Name="PlanSubText" Style="{StaticResource Hint}"/>
                                        <v:InlineMessage x:Name="SummaryMessage" ActionClick="SummaryRetry_Click"/>
                                        <!-- metric cards: two per row, each with an optional usage bar -->
                                        <ItemsControl x:Name="UsageMetrics" Margin="0,12,-8,0" Focusable="False" AutomationProperties.Name="{v:Loc acct_card_plan}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource B.Surface2}" CornerRadius="{StaticResource R.Control}" Padding="12,10" Margin="0,0,8,8">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Label}" Style="{StaticResource T.Label}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Visibility="{Binding DetailVisibility}"/>
                                                            <Border Visibility="{Binding BarVisibility}" Height="6" Margin="0,8,0,0" CornerRadius="3" Background="{StaticResource B.Surface3}"
                                                                    AutomationProperties.Name="{Binding BarName}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding Filled}"/><ColumnDefinition Width="{Binding Rest}"/></Grid.ColumnDefinitions>
                                                                    <Border CornerRadius="3" Background="{Binding BarBrush}"/>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="BillingNotice" Style="{StaticResource Hint}" Foreground="{StaticResource B.Thinking}" FontSize="12.5"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="UpgradeBtn" Style="{StaticResource Btn.FormPrimary}" Click="Upgrade_Click" Margin="{StaticResource S.ButtonGap}" ToolTip="{v:Loc tt_upgrade}"/>
                                            <Button x:Name="ManageBillingBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc manage_billing}" Click="Portal_Click" Margin="{StaticResource S.ButtonGap}" ToolTip="{v:Loc tt_manage_billing}"/>
                                        </WrapPanel>
                                        <v:InlineMessage x:Name="BillingMessage" ActionClick="BillingRetry_Click"/>
                                        <TextBlock x:Name="UpgradeStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock x:Name="BillingTerms" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Devices: one row per device with its own Remove action -->
                                <Border Style="{StaticResource Card}" Margin="{StaticResource S.CardGap}">
                                    <StackPanel>
                                        <TextBlock Text="{v:Loc devices}" Style="{StaticResource CardTitle}"/>
                                        <v:InlineMessage x:Name="DevicesMessage" ActionClick="DevicesRetry_Click" Margin="0,0,0,8"/>
                                        <ItemsControl x:Name="DeviceList" Focusable="False" AutomationProperties.Name="{v:Loc devices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0" Padding="0,10">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Form}" Content="{v:Loc dlg_remove}" Click="RemoveDevice_Click" Tag="{Binding}"
                                                                    AutomationProperties.Name="{Binding RemoveName}" ToolTip="{v:Loc tt_remove_device}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                                    IsEnabled="{Binding CanRemove}"/>
                                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource T.Icon}" Text="&#xE7F8;" FontSize="18" Foreground="{StaticResource B.TextDim}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <WrapPanel>
                                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                                                                    <Border Visibility="{Binding ThisPcVisibility}" CornerRadius="9" Padding="7,1" Background="{StaticResource B.AccentSoft}" VerticalAlignment="Center">
                                                                        <TextBlock Text="{v:Loc acct_device_this_pc_tag}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                                                    </Border>
                                                                </WrapPanel>
                                                                <TextBlock Text="{Binding Meta}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="DevicesEmpty" Style="{StaticResource Hint}" Text="{v:Loc acct_devices_empty}" Visibility="Collapsed"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="AccountSideColumn" Grid.Column="2">
                                <!-- Security -->
                                <Border Style="{StaticResource Card}" Margin="{StaticResource S.CardGap}">
                                    <StackPanel>
                                        <TextBlock Text="{v:Loc security}" Style="{StaticResource CardTitle}"/>
                                        <TextBlock x:Name="SecurityEmail" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                        <WrapPanel>
                                            <Button x:Name="ChangePasswordBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc change_password}" Click="ChangePassword_Click" Margin="{StaticResource S.ButtonGap}"/>
                                            <Button x:Name="SwitchAccountBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc switch_account}" Click="SwitchAccount_Click" Margin="{StaticResource S.ButtonGap}" ToolTip="{v:Loc tt_sign_in_another}"/>
                                        </WrapPanel>
                                        <v:InlineMessage x:Name="SecurityMessage"/>
                                    </StackPanel>
                                </Border>

                                <!-- Privacy & data -->
                                <Border Style="{StaticResource Card}" Margin="{StaticResource S.CardGap}">
                                    <StackPanel>
                                        <TextBlock Text="{v:Loc acct_card_privacy}" Style="{StaticResource CardTitle}"/>
                                        <WrapPanel>
                                            <Button x:Name="ExportAccountBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc export_my_data}" Click="ExportAccount_Click" Margin="{StaticResource S.ButtonGap}"/>
                                        </WrapPanel>
                                        <v:InlineMessage x:Name="PrivacyMessage"/>
                                        <TextBlock Style="{StaticResource Hint}" Text="{v:Loc reauth_hint}"/>
                                        <TextBlock x:Name="LegalHeader" Text="{v:Loc legal_support}" Style="{StaticResource T.Label}" Margin="0,16,0,4"/>
                                        <WrapPanel x:Name="LegalLinks" Margin="-6,0,0,0"/>
                                        <TextBlock x:Name="SupportEmailText" Style="{StaticResource Hint}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Danger zone: set apart, red outline -->
                                <Border x:Name="DangerZone" Style="{StaticResource Card}" BorderBrush="{StaticResource B.Error}" Margin="{StaticResource S.CardGap}">
                                    <StackPanel>
                                        <TextBlock Text="{v:Loc acct_card_danger}" Style="{StaticResource CardTitle}" Foreground="{StaticResource B.Error}"/>
                                        <TextBlock Style="{StaticResource T.Body}" Text="{v:Loc acct_danger_hint}"/>
                                        <Button x:Name="DeleteAccountBtn" Style="{StaticResource Btn.Form}" Foreground="{StaticResource B.Error}" BorderBrush="{StaticResource B.Error}" Content="{v:Loc delete_account}"
                                                Click="DeleteAccount_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                                        <v:InlineMessage x:Name="DangerMessage"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="NotConfiguredPanel" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="{v:Loc not_configured_install}"/>
                        </StackPanel>

                        <TextBlock Text="{v:Loc updates}" Style="{StaticResource Section}"/>
                        <TextBlock x:Name="BuildChannelText" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{v:Loc update_preference}" Style="{StaticResource T.Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ChannelBox" Grid.Column="1" MinWidth="180" SelectionChanged="Channel_Changed" AutomationProperties.Name="{v:Loc update_preference}">
                                <ComboBoxItem Content="{v:Loc channel_stable}" Tag="stable"/>
                                <ComboBoxItem Content="{v:Loc channel_beta}" Tag="beta"/>
                            </ComboBox>
                            <Button x:Name="RestartUpdateBtn" Grid.Column="3" Style="{StaticResource Btn.Form}" Content="{v:Loc restart_to_update}" Click="RestartUpdate_Click" Visibility="Collapsed"/>
                            <TextBlock x:Name="UpdateStatus" Grid.Row="1" Grid.ColumnSpan="4" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{v:Loc updates_hint}"/>
                    </StackPanel>

                    <!-- ===== Settings ===== -->
                    <v:SettingsPage x:Name="PageSettings" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
            </DockPanel>

            <!-- in-app dialogs: dim the whole window content (title bar and sidebar included) -->
            <v:DialogHost x:Name="Dialogs" Grid.RowSpan="2" Grid.ColumnSpan="2" CornerRadius="{Binding CornerRadius, ElementName=HomeRoot}"/>
        </Grid>
    </Border>
    <v:ToastHost x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Panel.ZIndex="10"/>
    </Grid>
</Window>
