<Window x:Class="InterviewAssistant.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:InterviewAssistant.App.Views"
        Title="Interview Assistant" Width="1040" Height="720" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize" ShowInTaskbar="True"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True" FlowDirection="{v:LocFlow}">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,20,0,8"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="List" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource B.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="Page" TargetType="FrameworkElement">
            <Setter Property="MaxWidth" Value="1120"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Grid Background="#01000000">
    <Border x:Name="HomeRoot" Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8" Effect="{StaticResource E.Shadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.ColumnSpan="2" Margin="18,12,10,6" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                    <Button x:Name="AccountBadge" Style="{StaticResource Btn.Ghost}" Margin="12,2,0,0" Padding="8,3" FontSize="12" Click="AccountBadge_Click"
                            ToolTip="{v:Loc tt_open_account}" AutomationProperties.Name="{v:Loc account}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="HeaderSignOutBtn" Style="{StaticResource Btn.Ghost}" Click="SignOut_Click" Margin="0,0,8,0" Padding="10,4"
                            ToolTip="{v:Loc tt_sign_out}" AutomationProperties.Name="{v:Loc sign_out}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE748;" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{v:Loc sign_out}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Click="Minimize_Click" ToolTip="{v:Loc tt_minimize}" AutomationProperties.Name="{v:Loc tt_minimize}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE921;" FontSize="11"/></Button>
                    <Button Style="{StaticResource Btn.Ghost}" Click="Maximize_Click" ToolTip="{v:Loc tt_maximize}" AutomationProperties.Name="{v:Loc tt_maximize}"><TextBlock x:Name="MaxIcon" Style="{StaticResource T.Icon}" Text="&#xE922;" FontSize="11"/></Button>
                    <Button Style="{StaticResource Btn.Ghost}" Click="Close_Click" ToolTip="{v:Loc tt_close_home}" AutomationProperties.Name="{v:Loc tt_close_home}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
                </StackPanel>
            </Grid>

            <!-- navigation -->
            <StackPanel Grid.Row="1" Margin="12,8,8,12">
                <Button x:Name="NavStart" Style="{StaticResource Nav}" Click="Nav_Click" Tag="start" Content="{v:Loc nav_start}"/>
                <Button x:Name="NavProfiles" Style="{StaticResource Nav}" Click="Nav_Click" Tag="profiles" Content="{v:Loc profiles}"/>
                <Button x:Name="NavInterviews" Style="{StaticResource Nav}" Click="Nav_Click" Tag="interviews" Content="{v:Loc interviews}"/>
                <Button x:Name="NavReports" Style="{StaticResource Nav}" Click="Nav_Click" Tag="reports" Content="{v:Loc reports}"/>
                <Button x:Name="NavAccount" Style="{StaticResource Nav}" Click="Nav_Click" Tag="account" Content="{v:Loc account}"/>
                <Button x:Name="NavSettings" Style="{StaticResource Nav}" Click="Settings_Click" Content="{v:Loc settings}"/>
                <Button x:Name="NavHelp" Style="{StaticResource Nav}" Click="Nav_Click" Tag="help" Content="{v:Loc nav_help}"/>
                <Border Height="1" Background="{StaticResource B.Border}" Margin="6,12"/>
                <TextBlock Text="{v:Loc ui_language}" Style="{StaticResource T.Label}" Margin="12,0,0,6"/>
                <ComboBox x:Name="UiLanguageBox" Style="{StaticResource Combo}" Margin="6,0" SelectionChanged="UiLanguage_Changed" DisplayMemberPath="DisplayName"
                          ToolTip="{v:Loc tt_ui_language}" AutomationProperties.Name="{v:Loc ui_language}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="12,6,6,0" FontSize="11" Text="{v:Loc ui_language_hint}"/>
            </StackPanel>

            <!-- content -->
            <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,8,8,12">
                <Grid Margin="8,0,16,8" MaxWidth="1120" HorizontalAlignment="Stretch">

                    <!-- ===== Get started ===== -->
                    <StackPanel x:Name="PageStart" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{v:Loc start_title}"/>
                        <TextBlock Style="{StaticResource Hint}" Text="{v:Loc start_subtitle}"/>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step1Title" Style="{StaticResource T.Label}"/>
                                <CheckBox x:Name="AckBox" Style="{StaticResource Check}" Margin="0,8,0,0" Checked="Ack_Changed" Unchecked="Ack_Changed">
                                    <TextBlock Text="{v:Loc authorized_use}" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" MaxWidth="560"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource Hint}" Text="{v:Loc start_step1_hint}"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step2Title" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step2Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="GoAccountBtn" Style="{StaticResource Btn.Primary}" Content="{v:Loc start_sign_in_or_create}" Click="GoAccount_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="DeveloperModeBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc start_developer_mode}" Click="DeveloperMode_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step3Title" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step3Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="StartImportBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc import_resume}" Click="NewProfile_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="StartInterviewProfileBtn" Style="{StaticResource Btn.Ghost}" Content="{v:Loc start_complete_profile}" Click="GoInterviewProfile_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step4Title" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step4Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="StartAddInterviewBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc start_add_interview}" Click="GoInterviews_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource Btn.Base}" Content="{v:Loc preflight}" Click="Readiness_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="DoneBtn" Style="{StaticResource Btn.Primary}" Content="{v:Loc start_interview}" Click="Done_Click" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="18,8"/>
                    </StackPanel>

                    <!-- ===== Profiles ===== -->
                    <Grid x:Name="PageProfiles" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="{v:Loc profiles}"/>
                            <ListBox x:Name="ProfileList" Style="{StaticResource List}" Height="300" Margin="0,8,0,8" SelectionChanged="ProfileList_SelectionChanged"
                                     AutomationProperties.Name="{v:Loc profiles}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Primary}" Content="{v:Loc import_resume}" Click="NewProfile_Click" Margin="0,0,6,6" ToolTip="{v:Loc tt_import_resume}"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc add_document}" Click="AddResume_Click" Margin="0,0,6,6" ToolTip="{v:Loc tt_add_document}"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc new_empty_profile}" Click="NewEmptyProfile_Click" Margin="0,0,6,6" ToolTip="{v:Loc tt_new_empty_profile}"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc export_ellipsis}" Click="ExportProfile_Click" Margin="0,0,6,6" ToolTip="{v:Loc tt_export_profile}"/>
                                <Button Style="{StaticResource Btn.Ghost}" Content="{v:Loc delete}" Click="DeleteProfile_Click" Margin="0,0,6,6" ToolTip="{v:Loc tt_delete_profile}"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc profile_local_hint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" x:Name="ProfileDetail">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{v:Loc profile_name}" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                                    <TextBox x:Name="ProfileName" Style="{StaticResource Input}" AutomationProperties.Name="{v:Loc profile_name}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{v:Loc profile_preferred_name}" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                                    <TextBox x:Name="ProfilePreferred" Style="{StaticResource Input}" AutomationProperties.Name="{v:Loc profile_preferred_name}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{v:Loc profile_headline}" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                                    <TextBox x:Name="ProfileHeadline" Style="{StaticResource Input}" AutomationProperties.Name="{v:Loc profile_headline}"/>
                                </StackPanel>
                            </Grid>

                            <!-- section switch -->
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button x:Name="TabFacts" Style="{StaticResource Btn.Chip}" Content="{v:Loc profile_tab_facts}" Click="ProfileTab_Click" Tag="facts"/>
                                <Button x:Name="TabPersonal" Style="{StaticResource Btn.Chip}" Content="{v:Loc profile_tab_personal}" Click="ProfileTab_Click" Tag="personal"/>
                            </StackPanel>

                            <!-- facts -->
                            <StackPanel x:Name="FactsPanel">
                                <DockPanel Margin="0,14,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn.Base}" Content="{v:Loc fact_add}" Click="AddFact_Click" Padding="10,4" Margin="0,0,6,0" ToolTip="{v:Loc tt_fact_add}"/>
                                        <Button Style="{StaticResource Btn.Base}" Content="{v:Loc confirm_all}" Click="ConfirmAll_Click" Padding="10,4" ToolTip="{v:Loc tt_confirm_all}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FactsHeader" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="{v:Loc facts_hint}"/>
                                <DockPanel Margin="0,2,0,6">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                        <Button x:Name="FilterAll" Style="{StaticResource Btn.Chip}" Content="{v:Loc filter_all}" Tag="all" Click="FactFilter_Click"/>
                                        <Button x:Name="FilterReview" Style="{StaticResource Btn.Chip}" Content="{v:Loc filter_review}" Tag="review" Click="FactFilter_Click"/>
                                        <Button x:Name="FilterConfirmed" Style="{StaticResource Btn.Chip}" Content="{v:Loc filter_confirmed}" Tag="confirmed" Click="FactFilter_Click"/>
                                    </StackPanel>
                                    <TextBlock x:Name="FactSummary" FontSize="11.5" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <ItemsControl x:Name="FactList" AutomationProperties.Name="{v:Loc profile_tab_facts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                                <DockPanel>
                                                    <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" IsChecked="{Binding Confirmed, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0"
                                                              ToolTip="{v:Loc tt_fact_confirm}" AutomationProperties.Name="{Binding Text}"/>
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                                        <Button Style="{StaticResource Btn.Ghost}" Padding="6,2" Click="EditFact_Click" Tag="{Binding}" ToolTip="{v:Loc tt_fact_edit}" AutomationProperties.Name="{v:Loc tt_fact_edit}">
                                                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE70F;" FontSize="11"/>
                                                        </Button>
                                                        <Button Style="{StaticResource Btn.Ghost}" Padding="6,2" Click="DeleteFact_Click" Tag="{Binding}" ToolTip="{v:Loc tt_fact_delete}" AutomationProperties.Name="{v:Loc tt_fact_delete}">
                                                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE74D;" FontSize="11"/>
                                                        </Button>
                                                    </StackPanel>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" FontSize="13"/>
                                                        <TextBlock Text="{Binding Meta}" TextWrapping="Wrap" Foreground="{StaticResource B.TextFaint}" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="FactsEmpty" Style="{StaticResource Hint}" Text="{v:Loc facts_empty}" Visibility="Collapsed"/>
                            </StackPanel>

                            <!-- interview profile (personal) -->
                            <StackPanel x:Name="PersonalPanel" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,4" Text="{v:Loc personal_intro}"/>
                                <StackPanel x:Name="PersonalFields"/>
                            </StackPanel>

                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource Btn.Primary}" Content="{v:Loc save_profile}" Click="SaveProfile_Click" Margin="0,0,8,0" Padding="16,7"/>
                                <TextBlock x:Name="ProfileDirty" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Interviews ===== -->
                    <Grid x:Name="PageInterviews" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="{v:Loc interviews}"/>
                            <TextBlock x:Name="InterviewsProfile" Style="{StaticResource Hint}"/>
                            <ListBox x:Name="TargetList" Style="{StaticResource List}" Height="300" Margin="0,8,0,8" SelectionChanged="TargetList_SelectionChanged" AutomationProperties.Name="{v:Loc interviews}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Primary}" Content="{v:Loc new_interview}" Click="NewTarget_Click" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource Btn.Ghost}" Content="{v:Loc delete}" Click="DeleteTarget_Click" Margin="0,0,6,6" ToolTip="{v:Loc tt_delete_interview}"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" x:Name="TargetDetail" MaxWidth="820" HorizontalAlignment="Left">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{v:Loc job_title}" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                                    <TextBox x:Name="TargetTitle" Style="{StaticResource Input}" AutomationProperties.Name="{v:Loc job_title}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{v:Loc company}" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                                    <TextBox x:Name="TargetCompany" Style="{StaticResource Input}" AutomationProperties.Name="{v:Loc company}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{v:Loc interview_language}" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="TargetLanguage" Style="{StaticResource Combo}" AutomationProperties.Name="{v:Loc interview_language}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{v:Loc answer_language}" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="TargetAnswerLanguage" Style="{StaticResource Combo}" AutomationProperties.Name="{v:Loc answer_language}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc language_separation_hint}"/>
                            <DockPanel Margin="0,14,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Base}" Content="{v:Loc import_file}" Click="ImportJd_Click" Padding="10,4"/>
                                <TextBlock Text="{v:Loc job_description}" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="TargetJd" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" Height="170" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                     AutomationProperties.Name="{v:Loc job_description}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc documents_are_data}"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="PrepareBtn" Style="{StaticResource Btn.Primary}" Content="{v:Loc prepare}" Click="Prepare_Click" Margin="0,0,8,0" Padding="16,7"/>
                                <Button x:Name="UseBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc start_interview}" Click="UseTarget_Click" Padding="14,7"/>
                            </WrapPanel>
                            <ProgressBar x:Name="PrepProgress" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1" Foreground="{StaticResource B.Accent}" Background="{StaticResource B.Surface3}" BorderThickness="0"/>
                            <TextBlock x:Name="PrepStatus" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="PrepSummary" Style="{StaticResource Hint}" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Reports ===== -->
                    <Grid x:Name="PageReports" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="560"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" Text="{v:Loc reports}"/>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc reports_hint}"/>
                            <ListBox x:Name="ReportList" Style="{StaticResource List}" Height="360" Margin="0,10,0,8" MouseDoubleClick="OpenReport_Click"
                                     SelectionChanged="ReportList_SelectionChanged" AutomationProperties.Name="{v:Loc reports}"/>
                            <TextBlock x:Name="ReportsEmpty" Style="{StaticResource Hint}" Text="{v:Loc reports_empty}" Visibility="Collapsed"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Primary}" Content="{v:Loc open}" Click="OpenReport_Click" Margin="0,0,8,6"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc copy_as_text}" Click="CopyReport_Click" Margin="0,0,8,6" ToolTip="{v:Loc tt_copy_report}"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc save_as_html}" Click="ExportReport_Click" Margin="0,0,8,6"/>
                                <Button Style="{StaticResource Btn.Ghost}" Content="{v:Loc delete}" Click="DeleteReport_Click" Margin="0,0,8,6"/>
                            </WrapPanel>
                        </StackPanel>
                        <!-- summary of the selected report (uses the space on wide screens) -->
                        <Border x:Name="ReportPreview" Grid.Column="1" Style="{StaticResource Card}" Margin="18,34,0,0" VerticalAlignment="Top" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ReportPreviewTitle" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="ReportPreviewMeta" Style="{StaticResource Hint}"/>
                                <TextBlock x:Name="ReportPreviewQuestions" Style="{StaticResource T.Body}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ===== Help & about ===== -->
                    <StackPanel x:Name="PageHelp" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{v:Loc nav_help}"/>
                        <TextBlock Text="{v:Loc help_getting_started}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_getting_started_body}"/>
                        <TextBlock Text="{v:Loc help_before}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_before_body}"/>
                        <TextBlock Text="{v:Loc help_controls}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_controls_body}"/>
                        <TextBlock Text="{v:Loc help_audio}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_audio_body}"/>
                        <TextBlock Text="{v:Loc help_honesty}" Style="{StaticResource Section}"/>
                        <TextBlock Style="{StaticResource T.Body}" TextWrapping="Wrap" Text="{v:Loc help_honesty_body}"/>
                        <TextBlock Text="{v:Loc help_about}" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Card}">
                            <Grid x:Name="AboutGrid">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            </Grid>
                        </Border>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Style="{StaticResource Btn.Base}" Content="{v:Loc copy_build_info}" Click="CopyBuildInfo_Click" Margin="0,0,8,0" ToolTip="{v:Loc tt_copy_build_info}"/>
                            <Button Style="{StaticResource Btn.Base}" Content="{v:Loc open_log_folder}" Click="OpenLogs_Click" ToolTip="{v:Loc tt_logs}"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ===== Account ===== -->
                    <StackPanel x:Name="PageAccount" Visibility="Collapsed" MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Style="{StaticResource H1}" Text="{v:Loc account}"/>
                        <TextBlock x:Name="AccountStatus" Style="{StaticResource Hint}" Foreground="{StaticResource B.TextDim}" FontSize="13"/>
                        <TextBlock x:Name="AccountError" Style="{StaticResource Hint}" Foreground="{StaticResource B.Error}"/>
                        <TextBlock x:Name="AccountInfo" Style="{StaticResource Hint}" Foreground="{StaticResource B.Listening}"/>

                        <!-- signed out: e-mail + password -->
                        <Border x:Name="SignedOutPanel" Style="{StaticResource Card}" Margin="0,12,0,0" MaxWidth="460" HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="ModeSignInBtn" Style="{StaticResource Btn.Chip}" Content="{v:Loc sign_in}" Click="ModeSignIn_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="ModeCreateBtn" Style="{StaticResource Btn.Chip}" Content="{v:Loc create_account}" Click="ModeCreate_Click"/>
                                </StackPanel>
                                <TextBlock Text="{v:Loc email}" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="EmailBox" Style="{StaticResource Input}" AutomationProperties.Name="{v:Loc email}" TabIndex="1" FlowDirection="LeftToRight"/>
                                <TextBlock Text="{v:Loc password}" Style="{StaticResource T.Label}" Margin="0,10,0,6"/>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="{v:Loc password}" TabIndex="2" KeyDown="Password_KeyDown" FlowDirection="LeftToRight"/>
                                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                                    <TextBlock Text="{v:Loc confirm_password}" Style="{StaticResource T.Label}" Margin="0,10,0,6"/>
                                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="{v:Loc confirm_password}" TabIndex="3" KeyDown="Password_KeyDown" FlowDirection="LeftToRight"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{v:Loc password_rules}"/>
                                    <TextBlock x:Name="SignUpLegal" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="AuthSubmitBtn" Style="{StaticResource Btn.Primary}" Content="{v:Loc sign_in}" Click="AuthSubmit_Click" Padding="18,7" Margin="0,0,10,0" TabIndex="4" IsDefault="False"/>
                                    <Button x:Name="ForgotBtn" Style="{StaticResource Btn.Ghost}" Content="{v:Loc forgot_password}" Click="Forgot_Click" TabIndex="5"/>
                                </WrapPanel>
                                <WrapPanel x:Name="ProviderButtons" Margin="0,10,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Text="{v:Loc password_privacy_hint}"/>
                            </StackPanel>
                        </Border>

                        <!-- signed in -->
                        <StackPanel x:Name="SignedInPanel" Margin="0,12,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="PlanText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                    <Grid x:Name="UsageGrid" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    </Grid>
                                    <TextBlock x:Name="BillingNotice" Style="{StaticResource Hint}" Foreground="{StaticResource B.Thinking}" FontSize="12.5"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="UpgradeBtn" Style="{StaticResource Btn.Primary}" Click="Upgrade_Click" Margin="0,0,8,8" ToolTip="{v:Loc tt_upgrade}"/>
                                        <Button x:Name="ManageBillingBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc manage_billing}" Click="Portal_Click" Margin="0,0,8,8" ToolTip="{v:Loc tt_manage_billing}"/>
                                        <Button Style="{StaticResource Btn.Ghost}" Content="{v:Loc refresh}" Click="RefreshAccount_Click" Margin="0,0,8,8" ToolTip="{v:Loc tt_refresh_account}"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="UpgradeStatus" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="BillingTerms" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{v:Loc devices}" Style="{StaticResource Section}"/>
                            <ListBox x:Name="DeviceList" Style="{StaticResource List}" Height="110" AutomationProperties.Name="{v:Loc devices}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="{v:Loc remove_device}" Click="RevokeDevice_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock Text="{v:Loc security}" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc change_password}" Click="ChangePassword_Click" Margin="0,0,8,6"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc sign_in_another}" Click="SwitchAccount_Click" Margin="0,0,8,6" ToolTip="{v:Loc tt_sign_in_another}"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc sign_out}" Click="SignOut_Click" Margin="0,0,8,6" ToolTip="{v:Loc tt_sign_out}"/>
                            </WrapPanel>
                            <TextBlock Text="{v:Loc privacy}" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc export_my_data}" Click="ExportAccount_Click" Margin="0,0,8,6"/>
                                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc delete_account}" Click="DeleteAccount_Click" Margin="0,0,8,6"/>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{v:Loc reauth_hint}"/>
                        </StackPanel>

                        <StackPanel x:Name="NotConfiguredPanel" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Hint}" FontSize="13" Text="{v:Loc not_configured_install}"/>
                        </StackPanel>

                        <TextBlock x:Name="LegalHeader" Text="{v:Loc legal_support}" Style="{StaticResource Section}"/>
                        <WrapPanel x:Name="LegalLinks"/>
                        <TextBlock x:Name="SupportEmailText" Style="{StaticResource Hint}"/>

                        <TextBlock Text="{v:Loc updates}" Style="{StaticResource Section}"/>
                        <TextBlock x:Name="BuildChannelText" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}"/>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{v:Loc update_preference}" Style="{StaticResource T.Body}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="ChannelBox" Grid.Column="1" Style="{StaticResource Combo}" SelectionChanged="Channel_Changed" AutomationProperties.Name="{v:Loc update_preference}">
                                <ComboBoxItem Content="{v:Loc channel_stable}" Tag="stable"/>
                                <ComboBoxItem Content="{v:Loc channel_beta}" Tag="beta"/>
                            </ComboBox>
                            <TextBlock x:Name="UpdateStatus" Grid.Column="2" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="RestartUpdateBtn" Grid.Column="3" Style="{StaticResource Btn.Base}" Content="{v:Loc restart_to_update}" Click="RestartUpdate_Click" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="{v:Loc updates_hint}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
    <v:ToastHost x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" Panel.ZIndex="10"/>
    </Grid>
</Window>
