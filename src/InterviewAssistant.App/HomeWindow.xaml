<Window x:Class="InterviewAssistant.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Home" Width="940" Height="680" MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" ShowInTaskbar="True"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource F.Display}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style x:Key="List" TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource B.Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8" Effect="{StaticResource E.Shadow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- title bar -->
            <Grid Grid.ColumnSpan="2" Margin="18,12,10,6" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="Interview Assistant" VerticalAlignment="Center"/>
                    <TextBlock x:Name="AccountBadge" Margin="14,4,0,0" FontSize="12" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" Click="Close_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
            </Grid>

            <!-- navigation -->
            <StackPanel Grid.Row="1" Margin="12,8,8,12">
                <Button x:Name="NavStart" Style="{StaticResource Nav}" Click="Nav_Click" Tag="start" Content="Get started"/>
                <Button x:Name="NavProfiles" Style="{StaticResource Nav}" Click="Nav_Click" Tag="profiles" Content="Profiles"/>
                <Button x:Name="NavInterviews" Style="{StaticResource Nav}" Click="Nav_Click" Tag="interviews" Content="Interviews"/>
                <Button x:Name="NavReports" Style="{StaticResource Nav}" Click="Nav_Click" Tag="reports" Content="Reports"/>
                <Button x:Name="NavAccount" Style="{StaticResource Nav}" Click="Nav_Click" Tag="account" Content="Account"/>
                <Button x:Name="NavSettings" Style="{StaticResource Nav}" Click="Settings_Click" Content="Settings"/>
                <Border Height="1" Background="{StaticResource B.Border}" Margin="6,12"/>
                <TextBlock Text="LANGUAGE" Style="{StaticResource T.Label}" Margin="12,0,0,6"/>
                <ComboBox x:Name="UiLanguageBox" Style="{StaticResource Combo}" Margin="6,0" SelectionChanged="UiLanguage_Changed" DisplayMemberPath="DisplayName" ToolTip="App language"/>
            </StackPanel>

            <!-- content -->
            <ScrollViewer Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="8,8,8,12">
                <Grid Margin="8,0,16,8">

                    <!-- ===== Get started ===== -->
                    <StackPanel x:Name="PageStart">
                        <TextBlock Style="{StaticResource H1}" Text="Get ready for your interview"/>
                        <TextBlock Style="{StaticResource Hint}" Text="An interview preparation and practice coach with a live assist mode. Four steps, about five minutes."/>

                        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step1Title" Text="1 · Authorized use" Style="{StaticResource T.Label}"/>
                                <CheckBox x:Name="AckBox" Style="{StaticResource Check}" Margin="0,8,0,0" Checked="Ack_Changed" Unchecked="Ack_Changed">
                                    <TextBlock x:Name="AckText" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" MaxWidth="560"/>
                                </CheckBox>
                                <TextBlock Style="{StaticResource Hint}" Text="Always follow the rules of the interview you are in. This app does not hide itself and does not record your microphone."/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step2Title" Text="2 · Account" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step2Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button x:Name="GoAccountBtn" Style="{StaticResource Btn.Primary}" Content="Sign in" Click="GoAccount_Click" Margin="0,0,8,0"/>
                                    <Button x:Name="DeveloperModeBtn" Style="{StaticResource Btn.Base}" Content="Developer build: use own OpenAI key" Click="DeveloperMode_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step3Title" Text="3 · Your profile" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step3Status" Style="{StaticResource Hint}"/>
                                <Button Style="{StaticResource Btn.Base}" Content="Import résumé…" Click="NewProfile_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock x:Name="Step4Title" Text="4 · The interview" Style="{StaticResource T.Label}"/>
                                <TextBlock x:Name="Step4Status" Style="{StaticResource Hint}"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource Btn.Base}" Content="Add interview…" Click="GoInterviews_Click" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource Btn.Base}" Content="Pre-interview check" Click="Readiness_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Button x:Name="DoneBtn" Style="{StaticResource Btn.Primary}" Content="Open live assistant" Click="Done_Click" HorizontalAlignment="Left" Margin="0,16,0,0" Padding="18,8"/>
                    </StackPanel>

                    <!-- ===== Profiles ===== -->
                    <Grid x:Name="PageProfiles" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" x:Name="ProfilesTitle" Text="Profiles"/>
                            <ListBox x:Name="ProfileList" Style="{StaticResource List}" Height="300" Margin="0,8,0,8" SelectionChanged="ProfileList_SelectionChanged" DisplayMemberPath="Label"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Primary}" Content="Import résumé…" Click="NewProfile_Click" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource Btn.Base}" Content="Add document…" Click="AddResume_Click" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource Btn.Base}" Content="Export…" Click="ExportProfile_Click" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource Btn.Ghost}" Content="Delete" Click="DeleteProfile_Click" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" x:Name="ProfileDetail">
                            <TextBlock Text="NAME" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                            <TextBox x:Name="ProfileName" Style="{StaticResource Input}"/>
                            <TextBlock Text="PREFERRED NAME" Style="{StaticResource Section}" Margin="0,10,0,6"/>
                            <TextBox x:Name="ProfilePreferred" Style="{StaticResource Input}"/>
                            <TextBlock Text="HEADLINE" Style="{StaticResource Section}" Margin="0,10,0,6"/>
                            <TextBox x:Name="ProfileHeadline" Style="{StaticResource Input}"/>
                            <DockPanel Margin="0,16,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Base}" Content="Confirm all" Click="ConfirmAll_Click" Padding="10,4"/>
                                <TextBlock x:Name="FactsHeader" Text="FACTS — REVIEW BEFORE USE" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6" Text="Only facts you confirm are ever presented as your experience. Untick anything wrong; edit by re-importing a corrected document."/>
                            <ItemsControl x:Name="FactList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource Check}" IsChecked="{Binding Confirmed, Mode=TwoWay}" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding KindLabel}" FontSize="10.5" Foreground="{StaticResource B.TextFaint}" Margin="8,2,0,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" FontSize="13"/>
                                                    <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Foreground="{StaticResource B.TextFaint}" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource Btn.Primary}" Content="Save profile" Click="SaveProfile_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Interviews ===== -->
                    <Grid x:Name="PageInterviews" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource H1}" x:Name="InterviewsTitle" Text="Interviews"/>
                            <TextBlock x:Name="InterviewsProfile" Style="{StaticResource Hint}"/>
                            <ListBox x:Name="TargetList" Style="{StaticResource List}" Height="300" Margin="0,8,0,8" SelectionChanged="TargetList_SelectionChanged" DisplayMemberPath="Label"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Primary}" Content="New interview" Click="NewTarget_Click" Margin="0,0,6,6"/>
                                <Button Style="{StaticResource Btn.Ghost}" Content="Delete" Click="DeleteTarget_Click" Margin="0,0,6,6"/>
                            </WrapPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" x:Name="TargetDetail">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="JOB TITLE" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                                    <TextBox x:Name="TargetTitle" Style="{StaticResource Input}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="COMPANY" Style="{StaticResource Section}" Margin="0,4,0,6"/>
                                    <TextBox x:Name="TargetCompany" Style="{StaticResource Input}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="INTERVIEW LANGUAGE" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="TargetLanguage" Style="{StaticResource Combo}" DisplayMemberPath="Label"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ANSWER LANGUAGE" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="TargetAnswerLanguage" Style="{StaticResource Combo}" DisplayMemberPath="Label"/>
                                </StackPanel>
                            </Grid>
                            <DockPanel Margin="0,14,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Base}" Content="Import file…" Click="ImportJd_Click" Padding="10,4"/>
                                <TextBlock Text="JOB DESCRIPTION" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBox x:Name="TargetJd" Style="{StaticResource Input}" AcceptsReturn="True" TextWrapping="Wrap" Height="170" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                            <TextBlock Style="{StaticResource Hint}" Text="Documents are treated as data only — instructions inside them are ignored."/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="PrepareBtn" Style="{StaticResource Btn.Primary}" Content="Save &amp; prepare" Click="Prepare_Click" Margin="0,0,8,0" Padding="16,7"/>
                                <Button x:Name="UseBtn" Style="{StaticResource Btn.Base}" Content="Use for live interview" Click="UseTarget_Click" Padding="14,7"/>
                            </WrapPanel>
                            <ProgressBar x:Name="PrepProgress" Height="4" Margin="0,12,0,0" Minimum="0" Maximum="1" Foreground="{StaticResource B.Accent}" Background="{StaticResource B.Surface3}" BorderThickness="0"/>
                            <TextBlock x:Name="PrepStatus" Style="{StaticResource Hint}"/>
                            <TextBlock x:Name="PrepSummary" Style="{StaticResource Hint}" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Reports ===== -->
                    <StackPanel x:Name="PageReports" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource H1}" x:Name="ReportsTitle" Text="Reports"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Reports describe the interviewer's questions and the suggestions shown. They are not a score and do not predict outcomes."/>
                        <ListBox x:Name="ReportList" Style="{StaticResource List}" Height="340" Margin="0,10,0,8" DisplayMemberPath="Label" MouseDoubleClick="OpenReport_Click"/>
                        <WrapPanel>
                            <Button Style="{StaticResource Btn.Primary}" Content="Open" Click="OpenReport_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Btn.Base}" Content="Save as HTML…" Click="ExportReport_Click" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="Delete" Click="DeleteReport_Click"/>
                        </WrapPanel>
                    </StackPanel>

                    <!-- ===== Account ===== -->
                    <StackPanel x:Name="PageAccount" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource H1}" x:Name="AccountTitle" Text="Account"/>
                        <TextBlock x:Name="AccountStatus" Style="{StaticResource Hint}" Foreground="{StaticResource B.TextDim}" FontSize="13"/>
                        <TextBlock x:Name="AccountError" Style="{StaticResource Hint}" Foreground="{StaticResource B.Error}"/>
                        <TextBlock x:Name="AccountInfo" Style="{StaticResource Hint}" Foreground="{StaticResource B.Listening}"/>

                        <!-- signed out: e-mail + password -->
                        <Border x:Name="SignedOutPanel" Style="{StaticResource Card}" Margin="0,12,0,0" MaxWidth="460" HorizontalAlignment="Left">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Button x:Name="ModeSignInBtn" Style="{StaticResource Btn.Chip}" Content="Sign in" Click="ModeSignIn_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="ModeCreateBtn" Style="{StaticResource Btn.Chip}" Content="Create account" Click="ModeCreate_Click"/>
                                </StackPanel>
                                <TextBlock Text="E-MAIL" Style="{StaticResource T.Label}" Margin="0,0,0,6"/>
                                <TextBox x:Name="EmailBox" Style="{StaticResource Input}" AutomationProperties.Name="E-mail" TabIndex="1"/>
                                <TextBlock Text="PASSWORD" Style="{StaticResource T.Label}" Margin="0,10,0,6"/>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Password" TabIndex="2" KeyDown="Password_KeyDown"/>
                                <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource T.Label}" Margin="0,10,0,6"/>
                                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="Confirm password" TabIndex="3" KeyDown="Password_KeyDown"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="At least 8 characters. Use letters and numbers."/>
                                    <TextBlock x:Name="SignUpLegal" Style="{StaticResource Hint}"/>
                                </StackPanel>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button x:Name="AuthSubmitBtn" Style="{StaticResource Btn.Primary}" Content="Sign in" Click="AuthSubmit_Click" Padding="18,7" Margin="0,0,10,0" TabIndex="4" IsDefault="False"/>
                                    <Button x:Name="ForgotBtn" Style="{StaticResource Btn.Ghost}" Content="Forgot password?" Click="Forgot_Click" TabIndex="5"/>
                                </WrapPanel>
                                <WrapPanel x:Name="ProviderButtons" Margin="0,10,0,0"/>
                                <TextBlock Style="{StaticResource Hint}" Text="Your password goes only to the secure sign-in service. The app stores an encrypted session on this PC so you stay signed in."/>
                            </StackPanel>
                        </Border>

                        <!-- signed in -->
                        <StackPanel x:Name="SignedInPanel" Margin="0,12,0,0">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="PlanText" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                                    <TextBlock x:Name="UsageText" Style="{StaticResource Hint}" FontSize="12.5"/>
                                    <TextBlock x:Name="BillingNotice" Style="{StaticResource Hint}" Foreground="{StaticResource B.Thinking}" FontSize="12.5"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="UpgradeBtn" Style="{StaticResource Btn.Primary}" Content="Upgrade to Pro" Click="Upgrade_Click" Margin="0,0,8,8" ToolTip="Opens secure checkout in your browser"/>
                                        <Button x:Name="ManageBillingBtn" Style="{StaticResource Btn.Base}" Content="Manage billing" Click="Portal_Click" Margin="0,0,8,8" ToolTip="Invoices, payment method, cancel or resume — opens in your browser"/>
                                        <Button Style="{StaticResource Btn.Ghost}" Content="Refresh" Click="RefreshAccount_Click" Margin="0,0,8,8" ToolTip="Reload plan and usage from the service"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="UpgradeStatus" Style="{StaticResource Hint}"/>
                                    <TextBlock x:Name="BillingTerms" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="DEVICES" Style="{StaticResource Section}"/>
                            <ListBox x:Name="DeviceList" Style="{StaticResource List}" Height="110" DisplayMemberPath="Label" AutomationProperties.Name="Devices"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="Remove selected device" Click="RevokeDevice_Click" HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock Text="PASSWORD" Style="{StaticResource Section}"/>
                            <Grid MaxWidth="460" HorizontalAlignment="Left">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <PasswordBox x:Name="NewPasswordBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="New password"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Base}" Content="Change password" Click="ChangePassword_Click" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Text="PRIVACY" Style="{StaticResource Section}"/>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Base}" Content="Export my data…" Click="ExportAccount_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Base}" Content="Delete account…" Click="DeleteAccount_Click" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Ghost}" Content="Sign out" Click="SignOut_Click"/>
                            </WrapPanel>
                        </StackPanel>

                        <StackPanel x:Name="NotConfiguredPanel" Margin="0,12,0,0">
                            <TextBlock x:Name="NotConfiguredText" Style="{StaticResource Hint}" FontSize="13" Text="This build is not connected to the Interview Assistant service. Please install the official release."/>
                        </StackPanel>

                        <TextBlock x:Name="LegalHeader" Text="LEGAL AND SUPPORT" Style="{StaticResource Section}"/>
                        <WrapPanel x:Name="LegalLinks"/>
                        <TextBlock x:Name="SupportEmailText" Style="{StaticResource Hint}"/>

                        <TextBlock Text="UPDATES" Style="{StaticResource Section}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ChannelBox" Style="{StaticResource Combo}" SelectionChanged="Channel_Changed">
                                <ComboBoxItem Content="Stable" Tag="stable"/>
                                <ComboBoxItem Content="Beta" Tag="beta"/>
                            </ComboBox>
                            <TextBlock x:Name="UpdateStatus" Grid.Column="1" Style="{StaticResource Hint}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <Button x:Name="RestartUpdateBtn" Grid.Column="2" Style="{StaticResource Btn.Base}" Content="Restart to update" Click="RestartUpdate_Click" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Updates never download or install during an interview session. A ready update installs when you close the app."/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
