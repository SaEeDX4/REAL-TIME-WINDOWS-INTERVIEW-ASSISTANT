<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:v="clr-namespace:InterviewAssistant.App.Views">
    <!-- ===== Colour tokens ===== -->
    <Color x:Key="C.Bg">#FF0F1115</Color>
    <Color x:Key="C.Surface">#FF161920</Color>
    <Color x:Key="C.Surface2">#FF1D212A</Color>
    <Color x:Key="C.Surface3">#FF252A35</Color>
    <Color x:Key="C.Border">#FF2A303C</Color>
    <Color x:Key="C.Text">#FFECEEF2</Color>
    <Color x:Key="C.TextDim">#FFA3A9B5</Color>
    <Color x:Key="C.TextFaint">#FF8B92A0</Color>
    <Color x:Key="C.Accent">#FF5B8DEF</Color>
    <Color x:Key="C.AccentSoft">#335B8DEF</Color>
    <!-- filled accent surfaces (primary buttons): white text on it stays above 4.5:1, also on hover -->
    <Color x:Key="C.AccentStrong">#FF3567D0</Color>
    <!-- input outlines: visible against both the page and the input fill -->
    <Color x:Key="C.InputBorder">#FF5C6577</Color>
    <!-- placeholder text: 4.5:1 on the input fill, clearly lighter than typed text -->
    <Color x:Key="C.Placeholder">#FF8F96A4</Color>
    <Color x:Key="C.Listening">#FF3DD68C</Color>
    <Color x:Key="C.Thinking">#FFF2B44C</Color>
    <Color x:Key="C.Error">#FFEF6B6B</Color>
    <Color x:Key="C.ErrorSoft">#40EF6B6B</Color>
    <!-- filled destructive buttons: white text above 4.5:1 -->
    <Color x:Key="C.ErrorStrong">#FFB3373A</Color>
    <!-- informational amber surfaces (profile-gap guidance): a tint of C.Thinking, never the error colour -->
    <Color x:Key="C.ThinkingSoft">#1FF2B44C</Color>
    <Color x:Key="C.Backdrop">#B3080A0E</Color>

    <SolidColorBrush x:Key="B.Bg" Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="B.Surface" Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="B.Surface2" Color="{StaticResource C.Surface2}"/>
    <SolidColorBrush x:Key="B.Surface3" Color="{StaticResource C.Surface3}"/>
    <SolidColorBrush x:Key="B.Border" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}"/>
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.AccentSoft" Color="{StaticResource C.AccentSoft}"/>
    <SolidColorBrush x:Key="B.AccentStrong" Color="{StaticResource C.AccentStrong}"/>
    <SolidColorBrush x:Key="B.InputBorder" Color="{StaticResource C.InputBorder}"/>
    <SolidColorBrush x:Key="B.Placeholder" Color="{StaticResource C.Placeholder}"/>
    <SolidColorBrush x:Key="B.Listening" Color="{StaticResource C.Listening}"/>
    <SolidColorBrush x:Key="B.Thinking" Color="{StaticResource C.Thinking}"/>
    <SolidColorBrush x:Key="B.Error" Color="{StaticResource C.Error}"/>
    <SolidColorBrush x:Key="B.ErrorSoft" Color="{StaticResource C.ErrorSoft}"/>
    <SolidColorBrush x:Key="B.ErrorStrong" Color="{StaticResource C.ErrorStrong}"/>
    <SolidColorBrush x:Key="B.ThinkingSoft" Color="{StaticResource C.ThinkingSoft}"/>
    <SolidColorBrush x:Key="B.Backdrop" Color="{StaticResource C.Backdrop}"/>

    <FontFamily x:Key="F.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Layout tokens (device-independent pixels: they scale with the Windows display scale) ===== -->
    <CornerRadius x:Key="R.Card">12</CornerRadius>
    <CornerRadius x:Key="R.Control">8</CornerRadius>
    <!-- focus ring drawn 3 px outside a control: radius = control radius + 3 -->
    <CornerRadius x:Key="R.FocusRing">11</CornerRadius>
    <sys:Double x:Key="S.ControlHeight">36</sys:Double>
    <sys:Double x:Key="S.ButtonHeight">36</sys:Double>
    <sys:Double x:Key="S.ButtonHeightCompact">30</sys:Double>
    <sys:Double x:Key="S.MultilineMinHeight">72</sys:Double>
    <sys:Double x:Key="S.InputFontSize">13.5</sys:Double>
    <Thickness x:Key="S.BorderThickness">1</Thickness>
    <Thickness x:Key="S.InputPadding">10,6</Thickness>
    <Thickness x:Key="S.MultilinePadding">10,8</Thickness>
    <Thickness x:Key="S.ButtonPadding">14,6</Thickness>
    <Thickness x:Key="S.FocusRingMargin">-3</Thickness>
    <!-- page content inside the Home content area -->
    <Thickness x:Key="S.PageMargin">8,0,16,8</Thickness>
    <sys:Double x:Key="S.PageMaxWidth">820</sys:Double>
    <!-- section headings: space above separates sections, space below ties the heading to its content -->
    <Thickness x:Key="S.SectionMargin">0,24,0,8</Thickness>
    <Thickness x:Key="S.FieldLabelMargin">0,12,0,6</Thickness>
    <Thickness x:Key="S.HintMargin">0,4,0,0</Thickness>
    <Thickness x:Key="S.ButtonRowMargin">0,14,0,0</Thickness>
    <Thickness x:Key="S.ButtonGap">0,0,8,8</Thickness>
    <GridLength x:Key="S.ColumnGap">12</GridLength>
    <!-- master/detail pages (Profiles, Interviews): fixed list pane, the detail takes the rest -->
    <GridLength x:Key="S.SidePaneWidth">240</GridLength>
    <!-- space between the two panes of a master/detail page -->
    <GridLength x:Key="S.PaneGap">20</GridLength>
    <sys:Double x:Key="S.PaneMinWidth">260</sys:Double>
    <!-- content width of the whole Home page area (detail panes stop growing here) -->
    <sys:Double x:Key="S.ContentMaxWidth">1120</sys:Double>
    <!-- vertical gap between stacked full-width buttons -->
    <Thickness x:Key="S.StackGap">0,0,0,8</Thickness>
    <!-- divider that separates a destructive action from the others -->
    <Thickness x:Key="S.DividerMargin">0,8,0,16</Thickness>

    <!-- ===== Layout tokens (rc.5): every page width, form column and field width comes from here — never a literal ===== -->
    <!-- reading pages (Get started, Help & about): comfortable line length -->
    <sys:Double x:Key="S.ReadingMaxWidth">760</sys:Double>
    <!-- centred two-column layouts (the sign-in page: product column + form card) -->
    <sys:Double x:Key="S.SplitMaxWidth">940</sys:Double>
    <!-- a single form column (Settings category content, the sign-in card's fields) -->
    <sys:Double x:Key="S.FormMaxWidth">620</sys:Double>
    <!-- a field whose value is short (hotkey, channel, font size): starts at the column start, never stretches -->
    <sys:Double x:Key="S.FieldShortWidth">320</sys:Double>
    <!-- a long multi-line field (job description) -->
    <sys:Double x:Key="S.MultilineTallHeight">170</sys:Double>
    <!-- the vertical gap between two fields of a form -->
    <Thickness x:Key="S.FieldGap">0,0,0,4</Thickness>
    <!-- inner padding of every card -->
    <Thickness x:Key="S.CardPadding">18,14</Thickness>

    <DropShadowEffect x:Key="E.Shadow" BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.35" Color="Black"/>

    <!-- Keyboard focus ring for controls that keep the system focus visual (the default dotted one is invisible on the dark theme) -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Stroke="{StaticResource B.Accent}" StrokeThickness="2" RadiusX="6" RadiusY="6" Margin="-2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text ===== -->
    <Style x:Key="T.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <!-- label above a form field (same spacing everywhere: Account, Settings, Profiles, dialogs) -->
    <Style x:Key="T.FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
        <Setter Property="Margin" Value="{StaticResource S.FieldLabelMargin}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- a secondary line under a field or a section (one style everywhere: no page-local hint styles) -->
    <Style x:Key="T.Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="{StaticResource S.HintMargin}"/>
    </Style>
    <!-- key / value rows (About, Settings → Updates, Help → Diagnostics, usage figures) -->
    <Style x:Key="T.MetaKey" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Margin" Value="0,3,16,3"/>
    </Style>
    <Style x:Key="T.MetaValue" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Margin" Value="0,3,0,3"/>
    </Style>
    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== Card ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Card}"/>
        <Setter Property="Padding" Value="{StaticResource S.CardPadding}"/>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Btn.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="MinHeight" Value="{StaticResource S.ButtonHeightCompact}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <!-- state overlay: works for every variant (ghost, chip, primary) without changing its colour -->
                        <Border x:Name="State" CornerRadius="{StaticResource R.Control}" Background="White" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Focus" CornerRadius="{StaticResource R.Control}" BorderBrush="{StaticResource B.Accent}" BorderThickness="2" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.07"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="State" Property="Opacity" Value="0.14"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                        <!-- Windows high contrast: system colours, visible outline -->
                        <DataTrigger Binding="{Binding IsOn, Source={x:Static v:HighContrast.Instance}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
                            <Setter TargetName="Focus" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.AccentStrong}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.AccentStrong}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- destructive action (Delete, Discard, Sign out during an interview) -->
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="{StaticResource B.ErrorStrong}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.ErrorStrong}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <!-- inline text action ("Try again" next to an inline message) -->
    <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Btn.Chip" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="Padding" Value="11,5"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
    </Style>
    <!-- form buttons: same height as the inputs next to them -->
    <Style x:Key="Btn.Form" TargetType="Button" BasedOn="{StaticResource Btn.Base}">
        <Setter Property="MinHeight" Value="{StaticResource S.ButtonHeight}"/>
        <Setter Property="Padding" Value="{StaticResource S.ButtonPadding}"/>
    </Style>
    <Style x:Key="Btn.FormPrimary" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="MinHeight" Value="{StaticResource S.ButtonHeight}"/>
        <Setter Property="Padding" Value="16,6"/>
    </Style>
    <Style x:Key="Btn.FormDanger" TargetType="Button" BasedOn="{StaticResource Btn.Danger}">
        <Setter Property="MinHeight" Value="{StaticResource S.ButtonHeight}"/>
        <Setter Property="Padding" Value="16,6"/>
    </Style>

    <!-- ===== Form controls =====
         One family for TextBox (single line and multi-line), PasswordBox and ComboBox (also editable): same height, radius,
         border, padding, fill, text colour, placeholder, caret and the same normal / hover / focus / error / disabled /
         read-only / high-contrast states. The placeholder (v:Watermark.Text) lives inside the template's content area with
         the text's own inset, never takes input, and is hidden while the field is focused or has text — so it can never
         sit under the caret. -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource S.InputFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.InputBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource S.BorderThickness}"/>
        <Setter Property="Padding" Value="{StaticResource S.InputPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource S.ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Validation.ErrorTemplate" Value="{x:Null}"/>
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="{StaticResource R.FocusRing}" Margin="{StaticResource S.FocusRingMargin}" BorderThickness="2"
                                BorderBrush="{StaticResource B.AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R.Control}" SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <!-- 2 px: the text editor's own inset, so placeholder and typed text start at the same x -->
                                <TextBlock x:Name="Placeholder" Margin="2,0" Text="{Binding Path=(v:Watermark.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource B.Placeholder}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           TextAlignment="{TemplateBinding TextAlignment}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                           IsHitTestVisible="False" Visibility="Collapsed" Focusable="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="Placeholder" Property="TextWrapping" Value="Wrap"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.TextDim}"/>
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="Validation.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Error}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource B.ErrorSoft}"/>
                        </Trigger>
                        <Trigger Property="v:Field.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Error}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource B.ErrorSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOn, Source={x:Static v:HighContrast.Instance}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- multi-line text starts at the top-left (top-right in RTL), never vertically centred -->
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top"/>
                <Setter Property="Padding" Value="{StaticResource S.MultilinePadding}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Input.Multiline" TargetType="TextBox" BasedOn="{StaticResource Input}">
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="MinHeight" Value="{StaticResource S.MultilineMinHeight}"/>
    </Style>
    <Style x:Key="PasswordInput" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="{StaticResource S.InputFontSize}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.InputBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource S.BorderThickness}"/>
        <Setter Property="Padding" Value="{StaticResource S.InputPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource S.ControlHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="v:Watermark.TrackPassword" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="{StaticResource R.FocusRing}" Margin="{StaticResource S.FocusRingMargin}" BorderThickness="2"
                                BorderBrush="{StaticResource B.AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R.Control}" SnapsToDevicePixels="True">
                            <Grid Margin="{TemplateBinding Padding}">
                                <TextBlock x:Name="Placeholder" Margin="2,0" Text="{Binding Path=(v:Watermark.Text), RelativeSource={RelativeSource TemplatedParent}}"
                                           Foreground="{StaticResource B.Placeholder}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Visibility="Collapsed" Focusable="False"/>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="v:Watermark.IsEmpty" Value="True"/>
                                <Condition Property="IsKeyboardFocused" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.TextDim}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="v:Field.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Error}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource B.ErrorSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOn, Source={x:Static v:HighContrast.Instance}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter TargetName="Placeholder" Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter Property="CaretBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- the text part of an editable ComboBox: no chrome of its own (the ComboBox draws the field) -->
    <Style x:Key="Input.Bare" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Text}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit defaults: every TextBox / PasswordBox / ComboBox in the app uses the shared family, also when built in code -->
    <Style TargetType="TextBox" BasedOn="{StaticResource Input}"/>
    <Style TargetType="PasswordBox" BasedOn="{StaticResource PasswordInput}"/>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource B.Surface3}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
    </Style>

    <!-- Slim scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="{StaticResource B.Surface3}" CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: same field as the inputs; the toggle only adds the chevron and the click target -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource F.Icons}" FontSize="10" Foreground="{StaticResource B.TextDim}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface3}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" x:Key="Combo">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.InputBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource S.BorderThickness}"/>
        <Setter Property="FontSize" Value="{StaticResource S.InputFontSize}"/>
        <Setter Property="MinHeight" Value="{StaticResource S.ControlHeight}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Ring" CornerRadius="{StaticResource R.FocusRing}" Margin="{StaticResource S.FocusRingMargin}" BorderThickness="2"
                                BorderBrush="{StaticResource B.AccentSoft}" Visibility="Collapsed" IsHitTestVisible="False"/>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource R.Control}" SnapsToDevicePixels="True"/>
                        <ToggleButton Style="{StaticResource ComboToggle}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <!-- DisplayMemberPath is implemented through ItemTemplateSelector: without it the closed box shows ToString() -->
                        <ContentPresenter x:Name="Content" IsHitTestVisible="False" Margin="13,0,32,0" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <TextBox x:Name="PART_EditableTextBox" Style="{StaticResource Input.Bare}" Visibility="Collapsed" Margin="11,0,32,0" VerticalAlignment="Center"
                                 FontSize="{TemplateBinding FontSize}" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="8" Padding="4" Margin="0,4,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer MaxHeight="280"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.TextDim}"/></Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="v:Field.HasError" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Error}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{StaticResource B.ErrorSoft}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Content" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsOn, Source={x:Static v:HighContrast.Instance}}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Combo}"/>
    <Style TargetType="CheckBox" x:Key="Check">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    </Style>
    <!-- Implicit styles: visible keyboard focus on the dark theme for controls that use the system templates -->
    <Style TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    </Style>
    <Style TargetType="Expander">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    </Style>

    <!-- ===== List rows (Home lists: profiles, interviews, reports, devices) =====
         Selection is a filled accent tint with an accent outline, visible with and without keyboard focus. -->
    <Style x:Key="ListItem.Row" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="Focus" CornerRadius="6" BorderBrush="{StaticResource B.Accent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface2}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOn, Source={x:Static v:HighContrast.Instance}}" Value="True"/>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented control (two or more equal segments; the selected one is filled with the accent) =====
         Built from RadioButtons (screen readers announce "selected", one group per control). The owner keeps only the
         selected segment as a tab stop and moves with Left/Right (see SegmentedNavigation). -->
    <Style x:Key="Seg.Track" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="{StaticResource S.BorderThickness}"/>
        <Setter Property="CornerRadius" Value="{StaticResource R.Control}"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="MinHeight" Value="{StaticResource S.ControlHeight}"/>
    </Style>
    <Style x:Key="Seg.Item" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="MinHeight" Value="{StaticResource S.ButtonHeightCompact}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,4">
                            <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextTrimming="CharacterEllipsis" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <Border x:Name="State" CornerRadius="6" Background="White" Opacity="0" IsHitTestVisible="False"/>
                        <Border x:Name="Focus" CornerRadius="8" BorderBrush="{StaticResource B.Accent}" BorderThickness="2" Margin="-2" Visibility="Collapsed" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="State" Property="Opacity" Value="0.06"/></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentStrong}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOn, Source={x:Static v:HighContrast.Instance}}" Value="True"/>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Separators and empty states ===== -->
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{StaticResource B.Border}"/>
        <Setter Property="Margin" Value="{StaticResource S.DividerMargin}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <!-- icon disc of an empty state ("No reports yet", "Select a report") -->
    <Style x:Key="EmptyState.Icon" TargetType="Border">
        <Setter Property="Width" Value="56"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="CornerRadius" Value="28"/>
        <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="T.EmptyTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- ===== Form field (rc.5): label row (label · ⓘ · accessory at the end), the field, an optional hint =====
         The one field layout of the app — see Views/FormField.cs. -->
    <Style TargetType="v:FormField">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Margin" Value="{StaticResource S.FieldGap}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="v:FormField">
                    <StackPanel>
                        <DockPanel Margin="{StaticResource S.FieldLabelMargin}" LastChildFill="True">
                            <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Accessory}" VerticalAlignment="Bottom" Margin="8,0,0,0"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="PART_Label" Text="{TemplateBinding Label}" Style="{StaticResource T.Label}" Margin="0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <v:InfoTip x:Name="PART_Info" Text="{TemplateBinding Info}" Margin="4,-4,0,-4"/>
                            </StackPanel>
                        </DockPanel>
                        <ContentPresenter x:Name="PART_Content" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        <TextBlock x:Name="PART_Hint" Text="{TemplateBinding Hint}" Style="{StaticResource T.Hint}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Hint" Value=""><Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="Hint" Value="{x:Null}"><Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed"/></Trigger>
                        <Trigger Property="IsShort" Value="True">
                            <Setter TargetName="PART_Content" Property="MaxWidth" Value="{StaticResource S.FieldShortWidth}"/>
                            <Setter TargetName="PART_Content" Property="Width" Value="{StaticResource S.FieldShortWidth}"/>
                            <Setter TargetName="PART_Content" Property="HorizontalAlignment" Value="Left"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
