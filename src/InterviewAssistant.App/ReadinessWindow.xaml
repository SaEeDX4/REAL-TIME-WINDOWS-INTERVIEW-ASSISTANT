<Window x:Class="InterviewAssistant.App.ReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:InterviewAssistant.App.Views"
        Title="Pre-interview check" Width="560" Height="600" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True">
    <Window.Resources>
        <v:LevelToWidth x:Key="LevelW" Max="160"/>
        <DataTemplate x:Key="CheckRow">
            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontFamily="{StaticResource F.Icons}" FontSize="15" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource B.Text}" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource B.TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding Brush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8" Effect="{StaticResource E.Shadow}">
        <DockPanel Margin="20,14,20,16">
            <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel>
                    <TextBlock Text="Pre-interview check" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                    <TextBlock Text="Join the Meet call (or play any video in Chrome), then run the checks." Style="{StaticResource T.Body}" Margin="0,4,0,12"/>
                </StackPanel>
                <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
            </Grid>
            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="Audio" Foreground="{StaticResource B.TextDim}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <Border Width="160" Height="6" CornerRadius="3" Background="{StaticResource B.Surface3}" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource B.Listening}" Width="{Binding AudioLevel, Converter={StaticResource LevelW}}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Btn.Base}" Content="Settings" Click="Settings_Click" Margin="0,0,8,0"/>
                    <Button x:Name="RunBtn" Style="{StaticResource Btn.Base}" Content="Run checks" Click="Run_Click" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource Btn.Primary}" Content="Start interview" Click="Start_Click" Padding="16,6"/>
                </StackPanel>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Checks" ItemTemplate="{StaticResource CheckRow}"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
