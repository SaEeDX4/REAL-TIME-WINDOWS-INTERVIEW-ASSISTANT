<Window x:Class="InterviewAssistant.App.ReadinessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:InterviewAssistant.App.Views"
        Title="{v:Loc preflight}" Width="640" Height="760" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True" FlowDirection="{v:LocFlow}">
    <Window.Resources>
        <v:LevelToWidth x:Key="LevelW" Max="220"/>
        <DataTemplate x:Key="CheckRow">
            <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Icon}" Foreground="{Binding Brush}" FontFamily="{StaticResource F.Icons}" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource B.Text}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{StaticResource B.TextDim}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Border Grid.Column="3" CornerRadius="8" Padding="8,2" Margin="10,0,0,0" BorderBrush="{Binding Brush}" BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding State}" Foreground="{Binding Brush}" FontSize="10.5" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Border Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8">
        <DockPanel Margin="20,14,20,16">
            <Grid DockPanel.Dock="Top" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel>
                    <TextBlock Text="{v:Loc preflight}" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"/>
                    <TextBlock Text="{v:Loc pf_subtitle}" Style="{StaticResource T.Body}" Margin="0,4,0,10" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" ToolTip="{v:Loc tt_close}" AutomationProperties.Name="{v:Loc tt_close}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
            </Grid>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Border x:Name="Verdict" CornerRadius="10" Padding="14,10" Margin="0,0,0,10" Background="{StaticResource B.Surface2}">
                    <StackPanel>
                        <TextBlock x:Name="VerdictTitle" Text="{v:Loc pf_not_checked}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.TextDim}"/>
                        <TextBlock x:Name="VerdictDetail" FontSize="12" Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button Style="{StaticResource Btn.Base}" Content="{v:Loc settings}" Click="Settings_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RunBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc pf_run_all}" Click="Run_Click" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn.Primary}" Content="{v:Loc pf_start_interview}" Click="Start_Click" Padding="16,6" ToolTip="{v:Loc tt_pf_start}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <StackPanel>
                <ItemsControl x:Name="Checks" ItemTemplate="{StaticResource CheckRow}"/>

                <TextBlock Text="{v:Loc pf_test_tools}" Style="{StaticResource T.Label}" Margin="0,10,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Button x:Name="AudioBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc pf_test_audio}" Click="TestAudio_Click" Margin="0,0,8,0"/>
                    <Button x:Name="SttBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc pf_test_stt}" Click="TestStt_Click" Margin="0,0,8,0"/>
                    <Button x:Name="AiBtn" Style="{StaticResource Btn.Base}" Content="{v:Loc pf_test_ai}" Click="TestAi_Click" Margin="0,0,16,0"/>
                    <Border Width="220" Height="6" CornerRadius="3" Background="{StaticResource B.Surface3}" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource B.Listening}" Width="{Binding AudioLevel, Converter={StaticResource LevelW}}"/>
                    </Border>
                </StackPanel>
                <Border Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="10" Padding="12,10" MinHeight="120">
                    <StackPanel>
                        <TextBlock x:Name="ToolTitle" Text="{v:Loc pf_pick_test}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ToolResult" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <TextBlock x:Name="ToolOutput" FontSize="12" Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Expander x:Name="ToolDiagnostics" Header="{v:Loc pf_technical_details}" Margin="0,8,0,0" Foreground="{StaticResource B.TextFaint}" Visibility="Collapsed">
                            <TextBlock x:Name="ToolDiagnosticsText" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource B.TextFaint}" TextWrapping="Wrap" Margin="0,4,0,0" FlowDirection="LeftToRight"/>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
