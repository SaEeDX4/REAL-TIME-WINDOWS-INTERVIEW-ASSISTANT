<UserControl x:Class="InterviewAssistant.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:InterviewAssistant.App.Views">
    <UserControl.Resources>
        <v:LevelToWidth x:Key="LevelW" Max="200"/>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Hint}"/>
        <Style x:Key="HotkeyBox" TargetType="TextBox" BasedOn="{StaticResource Input}">
            <Setter Property="FlowDirection" Value="LeftToRight"/>
        </Style>
        <Style x:Key="AboutKey" TargetType="TextBlock" BasedOn="{StaticResource T.MetaKey}"/>
        <Style x:Key="AboutValue" TargetType="TextBlock" BasedOn="{StaticResource T.MetaValue}"/>

        <!-- category list row: title + one-line description; the selected row has an accent bar on the reading-order
             start side (mirrors in RTL) and a filled background, visible with and without keyboard focus -->
        <Style x:Key="CategoryItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
            <Setter Property="Padding" Value="14,8,10,8"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource R.Control}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Bar" Width="3" CornerRadius="2" Margin="0,9" HorizontalAlignment="Left" Background="{StaticResource B.Accent}" Visibility="Collapsed" IsHitTestVisible="False"/>
                            <Border x:Name="Focus" CornerRadius="{StaticResource R.Control}" BorderBrush="{StaticResource B.Accent}" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Surface2}"/>
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Focus" Property="Visibility" Value="Visible"/></Trigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsOn, Source={x:Static v:HighContrast.Instance}}" Value="True"/>
                                    <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                            </MultiDataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- fills the content area (Home caps it at S.ContentMaxWidth); the category column is about a quarter, 180–250 px -->
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="180" MaxWidth="250"/>
            <ColumnDefinition Width="{StaticResource S.PaneGap}"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="{v:Loc settings}" FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                       VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level1"/>
            <v:InfoTip Text="{v:Loc set_save_hint}" Margin="6,2,0,0"/>
        </StackPanel>

        <!-- ===== category list (reading-order start side; Up/Down move within it) ===== -->
        <StackPanel Grid.Row="1">
            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource CategoryItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{v:Loc set_categories}"
                     SelectionMode="Single" SelectionChanged="CategoryList_SelectionChanged" PreviewKeyDown="CategoryList_PreviewKeyDown">
                <!-- no inner scroll viewer: the page scrolls as a whole and the mouse wheel keeps working over the list -->
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <!-- quiet footer of the list -->
            <Border Style="{StaticResource Divider}" Margin="6,12,6,8"/>
            <Button x:Name="RestoreAllBtn" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Click="RestoreAll_Click" Margin="4,0,0,0"
                    ToolTip="{v:Loc set_restore_body}" AutomationProperties.Name="{v:Loc set_restore_all}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource T.Icon}" Text="&#xE777;" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="{v:Loc set_restore_all}" FontSize="12.5" TextWrapping="Wrap"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- ===== the selected category (one at a time) =====
             a form-width column at the reading-order start (a capped star column: fields stretch to it, never centre) -->
        <Grid Grid.Row="1" Grid.Column="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="{StaticResource S.FormMaxWidth}"/></Grid.ColumnDefinitions>
        <StackPanel>
            <DockPanel>
                <Button x:Name="ResetSectionBtn" DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" VerticalAlignment="Top" Click="ResetSection_Click" Margin="8,0,0,0"
                        AutomationProperties.Name="{v:Loc set_reset_section}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE777;" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock Text="{v:Loc set_reset_section}" FontSize="12.5"/>
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CategoryTitle" FontFamily="{StaticResource F.Display}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"/>
                    <v:InfoTip x:Name="CategoryInfo" Margin="6,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <TextBlock x:Name="CategoryDescription" Style="{StaticResource T.Body}" Margin="0,2,0,4"/>

            <!-- ===== Audio ===== -->
            <StackPanel x:Name="CatAudio" Tag="audio">
                <v:FormField Label="{v:Loc set_audio_device}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceBox" SelectionChanged="DeviceBox_SelectionChanged" AutomationProperties.Name="{v:Loc set_audio_device}"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Form}" Click="RefreshDevices_Click" ToolTip="{v:Loc set_refresh_devices}" AutomationProperties.Name="{v:Loc set_refresh_devices}" Margin="8,0,0,0">
                            <TextBlock Style="{StaticResource T.Icon}" Text="&#xE72C;"/>
                        </Button>
                    </Grid>
                </v:FormField>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{v:Loc set_level}" Foreground="{StaticResource B.TextDim}" FontSize="12" VerticalAlignment="Center" MinWidth="40" Margin="0,0,8,0"/>
                    <v:LevelMeter Width="200" Height="6" CornerRadius="3" Background="{StaticResource B.Surface3}" VerticalAlignment="Center" AutomationProperties.Name="{v:Loc set_level}" Level="{Binding AudioLevel}">
                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource B.Listening}" Width="{Binding AudioLevel, Converter={StaticResource LevelW}}"/>
                    </v:LevelMeter>
                </StackPanel>
            </StackPanel>

            <!-- ===== Answers ===== -->
            <StackPanel x:Name="CatAnswers" Tag="answers" Visibility="Collapsed">
                <!-- developer builds only -->
                <StackPanel x:Name="DeveloperKeyPanel">
                    <v:FormField Label="{v:Loc set_dev_key}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <PasswordBox x:Name="KeyBox" AutomationProperties.Name="{v:Loc set_dev_key}" FlowDirection="LeftToRight" PasswordChanged="Changed"/>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Form}" Content="{v:Loc set_test}" Click="TestKey_Click" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="{v:Loc set_remove}" Click="RemoveKey_Click" Margin="4,0,0,0"/>
                        </Grid>
                    </v:FormField>
                    <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}" v:LiveRegion.Mode="Polite"/>
                    <!-- security statement: stays visible -->
                    <TextBlock Style="{StaticResource Hint}" Text="{v:Loc set_dev_key_hint}"/>
                </StackPanel>
                <v:FormField x:Name="ModelField" Label="{v:Loc set_answer_model}">
                    <ComboBox x:Name="ModelBox" IsEditable="True" AutomationProperties.Name="{v:Loc set_answer_model}" FlowDirection="LeftToRight"/>
                </v:FormField>
                <v:FormField x:Name="SttField" Label="{v:Loc set_stt_model}">
                    <ComboBox x:Name="SttBox" IsEditable="True" AutomationProperties.Name="{v:Loc set_stt_model}" FlowDirection="LeftToRight"/>
                </v:FormField>
                <v:FormField x:Name="ProtocolField" Label="{v:Loc set_protocol}" IsShort="True">
                    <ComboBox x:Name="ProtocolBox" AutomationProperties.Name="{v:Loc set_protocol}" SelectionChanged="Changed"/>
                </v:FormField>
                <v:FormField Label="{v:Loc set_font_size}" IsShort="True">
                    <ComboBox x:Name="FontBox" AutomationProperties.Name="{v:Loc set_font_size}" SelectionChanged="Changed"/>
                </v:FormField>
                <CheckBox x:Name="FastCacheBox" Style="{StaticResource Check}" Content="{v:Loc set_fast_cache}" Margin="0,14,0,0" Checked="Changed" Unchecked="Changed"/>
            </StackPanel>

            <!-- ===== Listening ===== -->
            <StackPanel x:Name="CatListening" Tag="listening" Visibility="Collapsed">
                <v:FormField Label="{v:Loc set_end_wait}" Info="{v:Loc set_end_wait_hint}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{v:Loc set_faster}" FontSize="11.5" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{v:Loc set_waits_longer}" FontSize="11.5" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Slider x:Name="VadSlider" Minimum="0.6" Maximum="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True" AutomationProperties.Name="{v:Loc set_end_wait}" ValueChanged="SliderChanged"/>
                    </DockPanel>
                </v:FormField>
            </StackPanel>

            <!-- ===== Window ===== -->
            <StackPanel x:Name="CatWindow" Tag="window" Visibility="Collapsed">
                <v:FormField Label="{v:Loc set_opacity}">
                    <Slider x:Name="OpacitySlider" Minimum="0.75" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            AutomationProperties.Name="{v:Loc set_opacity}" ValueChanged="SliderChanged"/>
                </v:FormField>
                <CheckBox x:Name="TopmostBox" Style="{StaticResource Check}" Content="{v:Loc set_topmost}" Margin="0,14,0,0" Checked="Changed" Unchecked="Changed"/>
            </StackPanel>

            <!-- ===== Hotkeys ===== -->
            <StackPanel x:Name="CatHotkeys" Tag="hotkeys" Visibility="Collapsed">
                <v:FormField Label="{v:Loc set_hk_toggle}" IsShort="True">
                    <StackPanel>
                        <TextBox x:Name="HkToggle" Style="{StaticResource HotkeyBox}" AutomationProperties.Name="{v:Loc set_hk_toggle}" TextChanged="Changed"/>
                        <v:InlineMessage x:Name="HkToggleError"/>
                    </StackPanel>
                </v:FormField>
                <v:FormField Label="{v:Loc set_hk_start}" IsShort="True">
                    <StackPanel>
                        <TextBox x:Name="HkStart" Style="{StaticResource HotkeyBox}" AutomationProperties.Name="{v:Loc set_hk_start}" TextChanged="Changed"/>
                        <v:InlineMessage x:Name="HkStartError"/>
                    </StackPanel>
                </v:FormField>
                <v:FormField Label="{v:Loc set_hk_manual}" IsShort="True">
                    <StackPanel>
                        <TextBox x:Name="HkManual" Style="{StaticResource HotkeyBox}" AutomationProperties.Name="{v:Loc set_hk_manual}" TextChanged="Changed"/>
                        <v:InlineMessage x:Name="HkManualError"/>
                    </StackPanel>
                </v:FormField>
            </StackPanel>

            <!-- ===== Privacy ===== -->
            <StackPanel x:Name="CatPrivacy" Tag="privacy" Visibility="Collapsed">
                <CheckBox x:Name="SaveTranscriptBox" Style="{StaticResource Check}" Content="{v:Loc set_save_transcript}" Margin="0,14,0,0" Checked="Changed" Unchecked="Changed"/>
                <!-- privacy statement: stays visible -->
                <TextBlock Style="{StaticResource Hint}" Text="{v:Loc set_save_transcript_hint}" Margin="0,6,0,0"/>
            </StackPanel>

            <!-- ===== Updates (moved here from Account in rc.5) ===== -->
            <StackPanel x:Name="CatUpdates" Tag="updates" Visibility="Collapsed">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource AboutKey}" Text="{v:Loc about_version}"/>
                    <TextBlock x:Name="UpdateVersion" Grid.Column="1" Style="{StaticResource AboutValue}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource AboutKey}" Text="{v:Loc about_channel}"/>
                    <TextBlock x:Name="UpdateChannelText" Grid.Row="1" Grid.Column="1" Style="{StaticResource AboutValue}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource AboutKey}" Text="{v:Loc about_build}"/>
                    <TextBlock x:Name="UpdateCommit" Grid.Row="2" Grid.Column="1" Style="{StaticResource AboutValue}" FlowDirection="LeftToRight" HorizontalAlignment="Left"/>
                </Grid>
                <!-- saved right away (not through the Save footer): it only takes effect after a restart -->
                <v:FormField Label="{v:Loc update_preference}" Hint="{v:Loc set_upd_pref_note}" IsShort="True">
                    <ComboBox x:Name="ChannelBox" SelectionChanged="Channel_Changed" AutomationProperties.Name="{v:Loc update_preference}">
                        <ComboBoxItem Content="{v:Loc channel_stable}" Tag="stable"/>
                        <ComboBoxItem Content="{v:Loc channel_beta}" Tag="beta"/>
                    </ComboBox>
                </v:FormField>
                <WrapPanel Margin="{StaticResource S.ButtonRowMargin}">
                    <Button x:Name="CheckUpdatesBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc set_upd_check}" Click="CheckUpdates_Click" Margin="{StaticResource S.ButtonGap}"/>
                    <Button x:Name="RestartUpdateBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc restart_to_update}" Click="RestartUpdate_Click" Margin="{StaticResource S.ButtonGap}" Visibility="Collapsed"/>
                </WrapPanel>
                <TextBlock x:Name="UpdateStatus" Style="{StaticResource T.Body}" Foreground="{StaticResource B.Text}" v:LiveRegion.Mode="Polite"/>
                <!-- the install rule: stays visible -->
                <TextBlock Style="{StaticResource Hint}" Text="{v:Loc set_upd_install_note}" Margin="0,8,0,0"/>
            </StackPanel>
        </StackPanel>
        </Grid>
    </Grid>
</UserControl>
