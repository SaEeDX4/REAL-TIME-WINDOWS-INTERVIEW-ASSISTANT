<UserControl x:Class="InterviewAssistant.App.Views.PreInterviewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:InterviewAssistant.App.Views">
    <UserControl.Resources>
        <v:LevelToWidth x:Key="LevelW" Max="200"/>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="{StaticResource S.SectionMargin}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Hint}"/>
        <!-- status badge: icon + text in the state's colour (never colour alone) -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="{StaticResource S.PageMaxWidth}" HorizontalAlignment="Left">
        <TextBlock Text="{v:Loc preflight}" FontFamily="{StaticResource F.Display}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                   Margin="0,0,0,4" AutomationProperties.HeadingLevel="Level1"/>
        <TextBlock Style="{StaticResource Hint}" Text="{v:Loc pf_subtitle}"/>

        <!-- ===== summary: state, n of 8, last checked, what blocks ===== -->
        <v:AccessibleBorder x:Name="SummaryCard" Style="{StaticResource Card}" Margin="0,16,0,0" Focusable="True" FocusVisualStyle="{StaticResource FocusRing}"
                v:LiveRegion.Mode="Polite">
            <StackPanel>
                <Border x:Name="StateBadge" Style="{StaticResource Badge}" Padding="10,3">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StateIcon" Style="{StaticResource T.Icon}" FontSize="12" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StateText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="SummaryLine" FontFamily="{StaticResource F.Display}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource B.Text}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock x:Name="CheckedAtText" Style="{StaticResource Hint}"/>
                <TextBlock x:Name="SummaryHint" Style="{StaticResource T.Body}" Margin="0,8,0,0"/>
                <StackPanel x:Name="BlockersPanel" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="BlockersTitle" Style="{StaticResource T.Label}" Margin="0,0,0,4"/>
                    <ItemsControl x:Name="BlockerList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3,0,0">
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource T.Icon}" Text="{Binding Icon}" Foreground="{Binding Brush}" FontSize="11"
                                               VerticalAlignment="Top" Margin="0,2,8,0"/>
                                    <TextBlock Text="{Binding Text}" Style="{StaticResource T.Body}" FontSize="12.5"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="TypedStillWork" Style="{StaticResource Hint}" Text="{v:Loc pf_typed_still_work}" Margin="0,8,0,0"/>
                </StackPanel>
            </StackPanel>
        </v:AccessibleBorder>

        <!-- ===== the eight checks (Tab moves row by row, then to the row's action) ===== -->
        <TextBlock Text="{v:Loc rd_checks_title}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}" Padding="0">
            <ItemsControl x:Name="CheckRows" Focusable="False" AutomationProperties.Name="{v:Loc rd_checks_title}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <v:AccessibleBorder BorderBrush="{StaticResource B.Border}" BorderThickness="{Binding Separator}" Padding="18,12" Background="Transparent"
                                Focusable="True" FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding AccessibleName}" IsListItem="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource T.Icon}" Text="{Binding Icon}" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" FontSize="12" Foreground="{StaticResource B.TextDim}"
                                               TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Badge}" BorderBrush="{Binding Brush}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource T.Icon}" Text="{Binding Icon}" Foreground="{Binding Brush}" FontSize="10" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Status}" Foreground="{Binding Brush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource Btn.Form}" Content="{Binding FixLabel}" Visibility="{Binding FixVisibility}"
                                        Tag="{Binding}" Click="Fix_Click" Margin="12,0,0,0" VerticalAlignment="Center" MinHeight="30" Padding="12,4"
                                        AutomationProperties.Name="{Binding FixAccessibleName}"/>
                            </Grid>
                        </v:AccessibleBorder>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ===== test tools: one output area for the last test ===== -->
        <TextBlock Text="{v:Loc pf_test_tools}" Style="{StaticResource Section}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource T.Body}" FontSize="12.5" Text="{v:Loc rd_tools_hint}"/>
                <!-- wraps in long languages: buttons first, the level meter moves to its own line when needed -->
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="AudioBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc pf_test_audio}" Click="TestAudio_Click" Margin="{StaticResource S.ButtonGap}"/>
                    <Button x:Name="SttBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc pf_test_stt}" Click="TestStt_Click" Margin="{StaticResource S.ButtonGap}"/>
                    <Button x:Name="AiBtn" Style="{StaticResource Btn.Form}" Content="{v:Loc pf_test_ai}" Click="TestAi_Click" Margin="0,0,16,8"/>
                    <v:LevelMeter Width="200" Height="6" CornerRadius="3" Background="{StaticResource B.Surface3}" VerticalAlignment="Center" Margin="0,0,0,8"
                            AutomationProperties.Name="{v:Loc tt_audio_meter}" ToolTip="{v:Loc tt_audio_meter}" Level="{Binding AudioLevel}">
                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource B.Listening}" Width="{Binding AudioLevel, Converter={StaticResource LevelW}}"/>
                    </v:LevelMeter>
                </WrapPanel>
                <Border Style="{StaticResource Divider}" Margin="0,4,0,12"/>
                <StackPanel>
                    <TextBlock x:Name="ToolTitle" v:LiveRegion.Mode="Polite" Text="{v:Loc pf_pick_test}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ToolResult" v:LiveRegion.Mode="Polite" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="ToolOutput" FontSize="12.5" Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <Expander x:Name="ToolDiagnostics" Header="{v:Loc pf_technical_details}" Margin="0,10,0,0" Foreground="{StaticResource B.TextFaint}" Visibility="Collapsed">
                    <TextBlock x:Name="ToolDiagnosticsText" FontFamily="Cascadia Mono, Consolas" FontSize="11" Foreground="{StaticResource B.TextFaint}" TextWrapping="Wrap"
                               Margin="0,6,0,0" FlowDirection="LeftToRight"/>
                </Expander>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
