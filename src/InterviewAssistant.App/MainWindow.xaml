<Window x:Class="InterviewAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:InterviewAssistant.App.Views"
        Title="Interview Assistant" Icon="Assets/app.ico"
        Width="720" Height="560" MinWidth="440" MinHeight="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" Topmost="True" ShowInTaskbar="True"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FlowDirection="{v:LocFlow}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <v:BoolToVisibility x:Key="BoolVis"/>
        <v:BoolToVisibility x:Key="BoolVisInv" Invert="True"/>
        <v:StringToVisibility x:Key="StrVis"/>
        <v:StringToVisibility x:Key="StrVisInv" Invert="True"/>
        <v:LevelToWidth x:Key="LevelW"/>
        <v:Multiply x:Key="LineH" Factor="1.42"/>
        <!-- header icon buttons: slightly tighter than Btn.Ghost so the header fits at the default width -->
        <Style x:Key="Btn.HeaderIcon" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Padding" Value="6,6"/>
        </Style>
        <!-- rows of the header popovers (More menu): full-width ghost buttons, text in the window's reading direction -->
        <Style x:Key="Btn.MenuRow" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="Popover.Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Surface2}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{StaticResource R.Card}"/>
            <Setter Property="Margin" Value="8,0,8,12"/>
            <Setter Property="Effect" Value="{StaticResource E.Shadow}"/>
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Cycle"/>
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle"/>
        </Style>

        <Storyboard x:Key="Pulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Background="#01000000"><!-- near-transparent: keeps the resize margin hit-testable on a layered window -->
    <!-- Shadow lives on a static, childless sibling so animations in the content never force the effect to re-render. -->
    <Border x:Name="ShadowLayer" Margin="8" CornerRadius="14" Background="{StaticResource B.Bg}" Effect="{StaticResource E.Shadow}"/>
    <Border x:Name="Root" Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header / drag area ===== -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent" Margin="14,10,8,6" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- status pill: shrinks first when the header is tight (status text trims, details in the tooltip) -->
                <Border Grid.Column="0" Background="{StaticResource B.Surface}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Padding="10,5,12,5"
                        HorizontalAlignment="Left" ToolTip="{Binding StatusDetail}">
                    <DockPanel>
                        <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding StatusBrush}" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusPulse}" Value="True">
                                            <DataTrigger.EnterActions><BeginStoryboard x:Name="PulseBegin" Storyboard="{StaticResource Pulse}"/></DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions><StopStoryboard BeginStoryboardName="PulseBegin"/></DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <!-- audio meter -->
                        <Border DockPanel.Dock="Right" Width="48" Height="4" CornerRadius="2" Background="{StaticResource B.Surface3}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="{v:Loc tt_audio_meter}">
                            <Border HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource B.Listening}" Width="{Binding AudioLevel, Converter={StaticResource LevelW}}"/>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                </Border>

                <!-- optional chips: shed first when the header is narrow (LiveChrome); the More menu takes what does not fit -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,4,0">
                    <Button x:Name="AdaptiveBadge" Style="{StaticResource Btn.Chip}" Padding="8,2" Background="{StaticResource B.AccentSoft}" BorderBrush="Transparent" Margin="0,0,6,0"
                            Visibility="Collapsed" ToolTip="{v:Loc tt_adaptive}" AutomationProperties.Name="{v:Loc tt_adaptive}" Click="Adaptive_Click">
                        <TextBlock Text="{Binding AdaptiveLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
                    </Button>
                    <Button x:Name="PresentationChip" Style="{StaticResource Btn.Chip}" Padding="8,2" BorderBrush="Transparent" Margin="0,0,6,0" ToolTip="{v:Loc tt_presentation}" AutomationProperties.Name="{v:Loc tt_presentation}" Click="Presentation_Click">
                        <TextBlock x:Name="PresentationText" Text="{Binding PresentationLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource B.TextDim}"/>
                    </Button>
                    <TextBlock x:Name="MinutesText" Text="{Binding MinutesLeftLabel}" FontSize="10.5" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" Margin="0,0,6,0"
                               ToolTip="{Binding MinutesTooltip}"/>
                </StackPanel>

                <!-- interview controls: primary first (Start/Pause), then Stop, readiness, quick help and the overflow menu -->
                <StackPanel x:Name="InterviewControls" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartBtn" Style="{StaticResource Btn.Primary}" Command="{Binding StartPauseCommand}" Padding="12,4" Margin="0,0,4,0" ToolTip="{v:Loc tt_start_pause}" AutomationProperties.Name="{Binding StartPauseLabel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StartIcon" Style="{StaticResource T.Icon}" Text="&#xE768;" FontSize="12"/>
                            <TextBlock x:Name="StartLabel" Text="{Binding StartPauseLabel}" Margin="6,0,0,0" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="StopBtn" Style="{StaticResource Btn.HeaderIcon}" Command="{Binding StopCommand}" ToolTip="{v:Loc tt_stop}" AutomationProperties.Name="{v:Loc tt_stop}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE71A;"/></Button>
                    <!-- readiness (the one pre-interview snapshot): a labelled pill in setup mode, a dot during the interview -->
                    <Button x:Name="ReadinessBtn" Style="{StaticResource Btn.HeaderIcon}" Padding="8,5" Margin="2,0" Click="Readiness_Click">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ReadinessDot" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource B.TextFaint}"/>
                            <TextBlock x:Name="ReadinessLabel" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HelpBtn" Style="{StaticResource Btn.HeaderIcon}" Click="Help_Click" ToolTip="{v:Loc tt_help}" AutomationProperties.Name="{v:Loc tt_help}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE897;"/></Button>
                    <Button x:Name="MoreBtn" Style="{StaticResource Btn.HeaderIcon}" Click="More_Click" ToolTip="{v:Loc tt_more}" AutomationProperties.Name="{v:Loc tt_more}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE712;"/></Button>
                </StackPanel>

                <!-- window controls: always last -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Button Style="{StaticResource Btn.HeaderIcon}" Click="Minimize_Click" ToolTip="{v:Loc tt_minimize}" AutomationProperties.Name="{v:Loc tt_minimize}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE921;" FontSize="11"/></Button>
                    <Button x:Name="MaxBtn" Style="{StaticResource Btn.HeaderIcon}" Click="Maximize_Click" ToolTip="{v:Loc tt_maximize}" AutomationProperties.Name="{v:Loc tt_maximize}"><TextBlock x:Name="MaxIcon" Style="{StaticResource T.Icon}" Text="&#xE922;" FontSize="11"/></Button>
                    <Button Style="{StaticResource Btn.HeaderIcon}" Click="Close_Click" ToolTip="{v:Loc tt_close}" AutomationProperties.Name="{v:Loc tt_close}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
                </StackPanel>
            </Grid>

            <!-- ===== Body ===== -->
            <Grid Grid.Row="1" Margin="14,4,14,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Service / plan banner: only when live help is blocked (signed out, offline, limit reached, expired) -->
                    <Button Style="{StaticResource Btn.Base}" Margin="0,0,0,8" Padding="10,5" Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Thinking}"
                            HorizontalContentAlignment="Stretch" Click="Banner_Click" Visibility="{Binding ServiceBanner, Converter={StaticResource StrVis}}"
                            ToolTip="{v:Loc tt_open_account}" AutomationProperties.Name="{Binding ServiceBanner}" AutomationProperties.HelpText="{v:Loc tt_open_account}">
                        <TextBlock Text="{Binding ServiceBanner}" FontSize="12" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"/>
                    </Button>
                </StackPanel>

                <!-- Question -->
                <Border x:Name="QuestionCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <!-- label row also carries a calm explanation of the state (no extra height taken from the answer) -->
                        <DockPanel x:Name="QuestionHeader" LastChildFill="True">
                            <TextBlock x:Name="QuestionLabel" DockPanel.Dock="Left" Text="{Binding LQuestion}" Style="{StaticResource T.Label}"/>
                            <TextBlock x:Name="StatusLine" Text="{Binding StatusDetail}" FontSize="11" Foreground="{StaticResource B.TextFaint}" Margin="12,0,0,8"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusDetail}"/>
                        </DockPanel>
                        <TextBlock Text="{Binding Question}" FlowDirection="{Binding QuestionFlowDirection}" FontSize="{Binding QuestionFontSize}" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"
                                   Visibility="{Binding Question, Converter={StaticResource StrVis}}"/>
                        <!-- the interviewer's background before the actual ask: short, never the whole monologue -->
                        <TextBlock x:Name="ContextLine" Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding ContextSummary}" Visibility="{Binding ContextSummary, Converter={StaticResource StrVis}}">
                            <Run Text="{v:Loc live_context}" FontWeight="SemiBold"/><Run Text=": "/><Run Text="{Binding ContextSummary, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding LWaiting}" FontSize="{Binding QuestionFontSize}" Foreground="{StaticResource B.TextFaint}"
                                   Visibility="{Binding Question, Converter={StaticResource StrVisInv}}"/>
                        <TextBlock Text="{Binding LiveTranscript}" FlowDirection="{Binding LiveTranscriptFlowDirection}" Margin="0,8,0,0" FontSize="13" FontStyle="Italic" Foreground="{StaticResource B.TextDim}" TextWrapping="Wrap"
                                   Visibility="{Binding LiveTranscript, Converter={StaticResource StrVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Answer -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Background="{StaticResource B.Surface}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel x:Name="AnswerHeader">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding AnswerMeta}" FontSize="11" Foreground="{StaticResource B.TextFaint}"/>
                            <TextBlock Text="{Binding LAnswer}" Style="{StaticResource T.Label}"/>
                        </DockPanel>
                        <ScrollViewer x:Name="AnswerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel x:Name="AnswerContent" MaxWidth="820" HorizontalAlignment="Stretch" FlowDirection="{Binding AnswerFlowDirection}">
                                <!-- Coach Mode: 3 keywords + one structure line, large and glanceable -->
                                <StackPanel Visibility="{Binding IsCoachView, Converter={StaticResource BoolVis}}" Margin="0,4,0,8">
                                    <TextBlock Text="{Binding LKeywords}" Style="{StaticResource T.Label}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding CoachKeywords}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"
                                               FontSize="{Binding CoachFontSize}"/>
                                    <TextBlock Text="{Binding LStructure}" Style="{StaticResource T.Label}" Margin="0,14,0,4"/>
                                    <TextBlock Text="{Binding CoachStructure}" TextWrapping="Wrap" Foreground="{StaticResource B.Text}" FontSize="{Binding AnswerFontSize}"/>
                                    <TextBlock Text="{Binding CoachReminder}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource B.TextDim}" FontSize="13"
                                               Visibility="{Binding CoachReminder, Converter={StaticResource StrVis}}"/>
                                </StackPanel>
                                <!-- Profile gap (personal question the profile has no answer for): guidance in a distinct amber card with its
                                     own title, never presented as the candidate's answer. Normal answers: no card chrome at all. -->
                                <Border x:Name="AnswerCard" Visibility="{Binding IsCoachView, Converter={StaticResource BoolVisInv}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProfileGap}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource B.Thinking}"/>
                                                    <Setter Property="BorderThickness" Value="3,1,1,1"/>
                                                    <Setter Property="Background" Value="{StaticResource B.ThinkingSoft}"/>
                                                    <Setter Property="CornerRadius" Value="{StaticResource R.Control}"/>
                                                    <Setter Property="Padding" Value="14,12,14,4"/>
                                                    <Setter Property="AutomationProperties.Name" Value="{Binding [live_gap_title], Source={x:Static v:LocSource.Instance}}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <DockPanel x:Name="ProfileGapHeader" Margin="0,0,0,10" FlowDirection="{v:LocFlow}" Visibility="{Binding IsProfileGap, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource T.Icon}" Text="&#xE946;" FontSize="16" Foreground="{StaticResource B.Thinking}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{v:Loc live_gap_title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" TextWrapping="Wrap"
                                                           AutomationProperties.HeadingLevel="Level2"/>
                                                <TextBlock Text="{v:Loc live_gap_subtitle}" Style="{StaticResource T.Body}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </DockPanel>
                                <ItemsControl x:Name="BulletList" ItemsSource="{Binding Bullets}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding DataContext.BulletMargin, RelativeSource={RelativeSource AncestorType=Window}}" Opacity="0">
                                                <Grid.RenderTransform><TranslateTransform Y="6"/></Grid.RenderTransform>
                                                <Grid.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22">
                                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Grid.Triggers>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Width="7" Height="7" Fill="{StaticResource B.Accent}" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                         Margin="2,13,0,0" Visibility="{Binding IsParagraph, Converter={StaticResource BoolVisInv}}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{StaticResource B.Text}"
                                                           FontSize="{Binding DataContext.AnswerFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           LineHeight="{Binding DataContext.AnswerLineHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                                           LineStackingStrategy="BlockLineHeight"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                        <Button x:Name="AddToProfileBtn" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="16,0,0,8" FlowDirection="{v:LocFlow}"
                                                Visibility="{Binding IsProfileGap, Converter={StaticResource BoolVis}}" Click="AddToProfile_Click"
                                                ToolTip="{v:Loc tt_live_gap_add}" AutomationProperties.Name="{v:Loc live_gap_add}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="{v:Loc live_gap_add}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <!-- bullet currently being written (faded, appended below stable bullets) -->
                                <TextBlock Text="{Binding Pending}" Margin="22,0,0,14" TextWrapping="Wrap" Foreground="{StaticResource B.TextFaint}"
                                           FontSize="{Binding AnswerFontSize}" Visibility="{Binding Pending, Converter={StaticResource StrVis}}"/>
                                <StackPanel Orientation="Horizontal" Margin="22,2,0,0" Visibility="{Binding IsThinking, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="●  ●  ●" Foreground="{StaticResource B.Accent}" FontSize="12">
                                        <TextBlock.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard Storyboard="{StaticResource Pulse}"/>
                                            </EventTrigger>
                                        </TextBlock.Triggers>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Note}" Margin="22,4,0,0" FontSize="12" Foreground="{StaticResource B.Thinking}" TextWrapping="Wrap"
                                           Visibility="{Binding Note, Converter={StaticResource StrVis}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Answer actions ===== -->
            <Grid x:Name="ActionBar" Grid.Row="2" Margin="14,0,14,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- chips wrap on narrow windows; history navigation always keeps its place -->
                <WrapPanel>
                    <Button Style="{StaticResource Btn.Chip}" Margin="0,0,6,4" Command="{Binding ShorterCommand}" Content="{Binding LShorter}" ToolTip="{v:Loc tt_shorter}"/>
                    <Button Style="{StaticResource Btn.Chip}" Margin="0,0,6,4" Command="{Binding TechnicalCommand}" Content="{Binding LTechnical}" ToolTip="{v:Loc tt_technical}"/>
                    <Button Style="{StaticResource Btn.Chip}" Margin="0,0,6,4" Command="{Binding ExampleCommand}" Content="{Binding LExample}" ToolTip="{v:Loc tt_example}"/>
                    <Button Style="{StaticResource Btn.Chip}" Margin="0,0,6,4" Command="{Binding FullCommand}" Content="{Binding LFull}" ToolTip="{v:Loc tt_full}"/>
                    <Button Style="{StaticResource Btn.Chip}" Margin="0,0,6,4" Command="{Binding RegenerateCommand}" ToolTip="{v:Loc tt_regenerate}" AutomationProperties.Name="{v:Loc regenerate}">
                        <TextBlock Style="{StaticResource T.Icon}" Text="&#xE72C;" FontSize="12"/>
                    </Button>
                </WrapPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding PreviousCommand}" ToolTip="{v:Loc tt_previous}" AutomationProperties.Name="{v:Loc tt_previous}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE76B;" FontSize="11"/></Button>
                    <TextBlock x:Name="HistoryCounterText" Text="{Binding HistoryLabel}" Foreground="{StaticResource B.TextFaint}" FontSize="11" VerticalAlignment="Center" Margin="2,0"
                               FlowDirection="LeftToRight" Visibility="{Binding HistoryLabel, Converter={StaticResource StrVis}}"/>
                    <Button Style="{StaticResource Btn.Ghost}" Command="{Binding NextCommand}" ToolTip="{v:Loc tt_next}" AutomationProperties.Name="{v:Loc tt_next}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE76C;" FontSize="11"/></Button>
                </StackPanel>
            </Grid>

            <!-- ===== Manual question (always-available fallback) ===== -->
            <Grid x:Name="ManualBar" Grid.Row="3" Margin="14,0,14,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{StaticResource S.ColumnGap}"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- shared input: the placeholder sits inside the field with the text's inset and hides while focused or filled.
                     Field and send button share the control-height token and are centred on one row (mirrored in RTL). -->
                <TextBox x:Name="ManualInput" KeyDown="ManualInput_KeyDown" v:Watermark.Text="{Binding LTypeHint}" VerticalAlignment="Center"
                         Height="{StaticResource S.ControlHeight}" AutomationProperties.Name="{Binding LTypeHint}"/>
                <Button x:Name="ManualSendBtn" Grid.Column="2" Style="{StaticResource Btn.FormPrimary}" Padding="0" VerticalAlignment="Center"
                        Width="{StaticResource S.ControlHeight}" Height="{StaticResource S.ControlHeight}"
                        Click="ManualSend_Click" ToolTip="{v:Loc tt_send}" AutomationProperties.Name="{v:Loc tt_send}">
                    <TextBlock Style="{StaticResource T.Icon}" Text="&#xE724;" HorizontalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- rc.5: no diagnostics panel here — technical details live in Home → Help & about → Diagnostics -->

            <!-- first-time introduction (short; reopen with the ? button) -->
            <Border x:Name="LiveIntro" Grid.Row="1" Grid.RowSpan="3" Margin="14,4,14,10" Padding="20,16" CornerRadius="12" Panel.ZIndex="5"
                    Background="{StaticResource B.Surface2}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" VerticalAlignment="Top"
                    Visibility="{Binding ShowLiveIntro, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="{v:Loc live_intro_title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,0,0,5" Text="{v:Loc live_intro_1}"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,0,0,5" Text="{v:Loc live_intro_2}"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,0,0,5" Text="{v:Loc live_intro_3}"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,0,0,5" Text="{v:Loc live_intro_4}"/>
                    <TextBlock Style="{StaticResource T.Body}" Margin="0,0,0,12" Text="{v:Loc live_intro_5}"/>
                    <DockPanel LastChildFill="False">
                        <CheckBox x:Name="IntroDontShow" Style="{StaticResource Check}" Content="{v:Loc live_intro_dont_show}" VerticalAlignment="Center" Foreground="{StaticResource B.TextDim}"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" Content="{v:Loc live_intro_got_it}" Click="IntroClose_Click" Padding="18,6" IsCancel="True"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ===== More (overflow) menu: anchored under its button, Escape / click outside closes, focus returns ===== -->
            <Popup x:Name="MorePopup" PlacementTarget="{Binding ElementName=MoreBtn}" Placement="Custom" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                <Border x:Name="MoreCard" Style="{StaticResource Popover.Card}" Padding="6" MinWidth="230" MaxWidth="320" FlowDirection="{v:LocFlow}" AutomationProperties.Name="{v:Loc tt_more}">
                    <StackPanel>
                        <Button x:Name="MoreCompact" Style="{StaticResource Btn.MenuRow}" Click="MoreCompact_Click" AutomationProperties.Name="{v:Loc more_compact}">
                            <DockPanel>
                                <TextBlock x:Name="MoreCompactCheck" DockPanel.Dock="Right" Style="{StaticResource T.Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource B.Accent}" Margin="10,0,0,0"/>
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE73F;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource B.TextDim}"/>
                                <TextBlock Text="{v:Loc more_compact}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="MoreCoach" Style="{StaticResource Btn.MenuRow}" Click="Presentation_Click" AutomationProperties.Name="{v:Loc more_coach}">
                            <DockPanel>
                                <TextBlock x:Name="MoreCoachCheck" DockPanel.Dock="Right" Style="{StaticResource T.Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource B.Accent}" Margin="10,0,0,0"/>
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE8FD;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource B.TextDim}"/>
                                <TextBlock Text="{v:Loc more_coach}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="MoreFocus" Style="{StaticResource Btn.MenuRow}" Click="MoreFocus_Click" AutomationProperties.Name="{v:Loc more_focus}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE714;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource B.TextDim}"/>
                                <TextBlock Text="{v:Loc more_focus}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="MoreFocusRestore" Style="{StaticResource Btn.MenuRow}" Click="MoreFocusRestore_Click" Visibility="Collapsed" AutomationProperties.Name="{v:Loc focus_restore}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE7A7;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource B.TextDim}"/>
                                <TextBlock Text="{v:Loc focus_restore}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Border Style="{StaticResource Divider}" Margin="8,4"/>
                        <Button x:Name="MoreHome" Style="{StaticResource Btn.MenuRow}" Click="Home_Click" ToolTip="{v:Loc tt_home}" AutomationProperties.Name="{v:Loc more_home}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE80F;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource B.TextDim}"/>
                                <TextBlock Text="{v:Loc more_home}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="MoreReport" Style="{StaticResource Btn.MenuRow}" Click="Report_Click" ToolTip="{v:Loc tt_last_report}" AutomationProperties.Name="{v:Loc more_last_report}"
                                Visibility="{Binding LastReportPath, Converter={StaticResource StrVis}}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE9F9;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource B.TextDim}"/>
                                <TextBlock Text="{v:Loc more_last_report}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <Button x:Name="MoreSettings" Style="{StaticResource Btn.MenuRow}" Click="Settings_Click" AutomationProperties.Name="{v:Loc settings}">
                            <DockPanel>
                                <TextBlock Style="{StaticResource T.Icon}" Text="&#xE713;" FontSize="13" Margin="0,0,10,0" Foreground="{StaticResource B.TextDim}"/>
                                <TextBlock Text="{v:Loc settings}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </Button>
                        <!-- minutes left: here when the header has no room for the label -->
                        <TextBlock x:Name="MoreMinutes" Text="{Binding MinutesLeftLabel}" ToolTip="{Binding MinutesTooltip}" FontSize="11" Foreground="{StaticResource B.TextFaint}" Margin="10,6,10,4"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- notifications: bottom of the window, over the action/typing area — never over the answer text -->
            <v:ToastHost x:Name="Toasts" Grid.Row="2" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12,0,12,10" Panel.ZIndex="10"/>
            <!-- in-app dialogs: dim the whole window content -->
            <v:DialogHost x:Name="Dialogs" Grid.RowSpan="5" CornerRadius="13"/>
        </Grid>
    </Border>
    </Grid>
</Window>
