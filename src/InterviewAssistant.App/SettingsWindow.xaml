<Window x:Class="InterviewAssistant.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:InterviewAssistant.App.Views"
        Title="{v:Loc settings}" Width="560" Height="720" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True" FlowDirection="{v:LocFlow}">
    <Window.Resources>
        <v:LevelToWidth x:Key="LevelW" Max="200"/>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,18,0,8"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8" Effect="{StaticResource E.Shadow}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="20,14,10,4" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="{v:Loc settings}" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"
                           AutomationProperties.HeadingLevel="Level1"/>
                <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" Click="Cancel_Click" ToolTip="{v:Loc tt_close}" AutomationProperties.Name="{v:Loc tt_close}"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
                <TextBlock x:Name="SaveStatus" Foreground="{StaticResource B.Error}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="300" TextWrapping="Wrap"/>
                <Button Style="{StaticResource Btn.Base}" Content="{v:Loc cancel}" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,7" IsCancel="True"/>
                <Button Style="{StaticResource Btn.Primary}" Content="{v:Loc save}" Click="Save_Click" Padding="20,7" IsDefault="True"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,12,0">
                <StackPanel Margin="0,0,8,8">
                    <StackPanel x:Name="DeveloperKeyPanel">
                    <TextBlock Text="{v:Loc set_dev_key}" Style="{StaticResource Section}" Margin="0,8,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="KeyBox" Style="{StaticResource PasswordInput}" AutomationProperties.Name="{v:Loc set_dev_key}" FlowDirection="LeftToRight"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Base}" Content="{v:Loc set_test}" Click="TestKey_Click" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="{v:Loc set_remove}" Click="RemoveKey_Click" Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{v:Loc set_dev_key_hint}"/>
                    </StackPanel>

                    <TextBlock Text="{v:Loc set_audio}" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceBox" Style="{StaticResource Combo}" SelectionChanged="DeviceBox_SelectionChanged" AutomationProperties.Name="{v:Loc set_audio}"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Click="RefreshDevices_Click" ToolTip="{v:Loc set_refresh_devices}" AutomationProperties.Name="{v:Loc set_refresh_devices}" Margin="4,0,0,0"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE72C;"/></Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{v:Loc set_level}" Foreground="{StaticResource B.TextDim}" FontSize="12" VerticalAlignment="Center" MinWidth="40" Margin="0,0,8,0"/>
                        <Border Width="200" Height="6" CornerRadius="3" Background="{StaticResource B.Surface3}" VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource B.Listening}" Width="{Binding AudioLevel, Converter={StaticResource LevelW}}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{v:Loc set_audio_hint}"/>

                    <TextBlock Text="{v:Loc set_answers}" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock x:Name="ModelLabel" Text="{v:Loc set_answer_model}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ModelBox" Grid.Column="1" Style="{StaticResource Combo}" IsEditable="True" Margin="0,3" AutomationProperties.Name="{v:Loc set_answer_model}" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="SttLabel" Grid.Row="1" Text="{v:Loc set_stt_model}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SttBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Combo}" IsEditable="True" Margin="0,3" AutomationProperties.Name="{v:Loc set_stt_model}" FlowDirection="LeftToRight"/>
                        <TextBlock x:Name="ProtocolLabel" Grid.Row="2" Text="{v:Loc set_protocol}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProtocolBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,3" AutomationProperties.Name="{v:Loc set_protocol}"/>
                        <TextBlock Grid.Row="3" Text="{v:Loc set_font_size}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,3" AutomationProperties.Name="{v:Loc set_font_size}"/>
                    </Grid>
                    <CheckBox x:Name="FastCacheBox" Style="{StaticResource Check}" Content="{v:Loc set_fast_cache}" Margin="0,10,0,0"/>

                    <TextBlock Text="{v:Loc set_listening}" Style="{StaticResource Section}"/>
                    <TextBlock Text="{v:Loc set_end_wait}" Style="{StaticResource T.Body}"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{v:Loc set_faster}" FontSize="11" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" MinWidth="46" Margin="0,0,8,0"/>
                        <TextBlock DockPanel.Dock="Right" Text="{v:Loc set_waits_longer}" FontSize="11" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Slider x:Name="VadSlider" Minimum="0.6" Maximum="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True" AutomationProperties.Name="{v:Loc set_end_wait}"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{v:Loc set_end_wait_hint}"/>

                    <TextBlock Text="{v:Loc set_window}" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="{v:Loc set_opacity}" Style="{StaticResource T.Body}" VerticalAlignment="Center" Width="150"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.75" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" AutomationProperties.Name="{v:Loc set_opacity}"/>
                    </DockPanel>
                    <CheckBox x:Name="TopmostBox" Style="{StaticResource Check}" Content="{v:Loc set_topmost}" Margin="0,8,0,0"/>

                    <TextBlock Text="{v:Loc set_hotkeys}" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="{v:Loc set_hk_toggle}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="HkToggle" Grid.Column="1" Style="{StaticResource Input}" Margin="0,3" AutomationProperties.Name="{v:Loc set_hk_toggle}" FlowDirection="LeftToRight"/>
                        <TextBlock Grid.Row="1" Text="{v:Loc set_hk_start}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="HkStart" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}" Margin="0,3" AutomationProperties.Name="{v:Loc set_hk_start}" FlowDirection="LeftToRight"/>
                        <TextBlock Grid.Row="2" Text="{v:Loc set_hk_manual}" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="HkManual" Grid.Row="2" Grid.Column="1" Style="{StaticResource Input}" Margin="0,3" AutomationProperties.Name="{v:Loc set_hk_manual}" FlowDirection="LeftToRight"/>
                    </Grid>

                    <TextBlock Text="{v:Loc privacy}" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="SaveTranscriptBox" Style="{StaticResource Check}" Content="{v:Loc set_save_transcript}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="{v:Loc set_save_transcript_hint}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
