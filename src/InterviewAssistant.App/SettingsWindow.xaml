<Window x:Class="InterviewAssistant.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:InterviewAssistant.App.Views"
        Title="Settings" Width="560" Height="720" WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource F.Ui}" UseLayoutRounding="True">
    <Window.Resources>
        <v:LevelToWidth x:Key="LevelW" Max="200"/>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="Margin" Value="0,18,0,8"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource T.Body}">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>
    <Border Background="{StaticResource B.Bg}" BorderBrush="{StaticResource B.Border}" BorderThickness="1" CornerRadius="14" Margin="8" Effect="{StaticResource E.Shadow}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="20,14,10,4" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="Settings" FontFamily="{StaticResource F.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" VerticalAlignment="Center"/>
                <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Right" Click="Cancel_Click"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE8BB;" FontSize="11"/></Button>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,8,20,16">
                <Button Style="{StaticResource Btn.Base}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0" Padding="16,7"/>
                <Button Style="{StaticResource Btn.Primary}" Content="Save" Click="Save_Click" Padding="20,7"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,0,12,0">
                <StackPanel Margin="0,0,8,8">
                    <TextBlock Text="OPENAI API KEY" Style="{StaticResource Section}" Margin="0,8,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="KeyBox" Style="{StaticResource PasswordInput}"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Base}" Content="Test" Click="TestKey_Click" Margin="8,0,0,0"/>
                        <Button Grid.Column="2" Style="{StaticResource Btn.Ghost}" Content="Remove" Click="RemoveKey_Click" Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock x:Name="KeyStatus" Style="{StaticResource Hint}"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Stored encrypted with Windows DPAPI for your Windows account only. Never written in plain text or logged."/>

                    <TextBlock Text="AUDIO — INTERVIEWER PLAYBACK DEVICE" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="DeviceBox" Style="{StaticResource Combo}" SelectionChanged="DeviceBox_SelectionChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" Click="RefreshDevices_Click" ToolTip="Refresh devices" Margin="4,0,0,0"><TextBlock Style="{StaticResource T.Icon}" Text="&#xE72C;"/></Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Level" Foreground="{StaticResource B.TextDim}" FontSize="12" VerticalAlignment="Center" Width="40"/>
                        <Border Width="200" Height="6" CornerRadius="3" Background="{StaticResource B.Surface3}" VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource B.Listening}" Width="{Binding AudioLevel, Converter={StaticResource LevelW}}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Choose the device Chrome/Meet plays through (your headset). Play any video in Chrome: the level bar must move. Your microphone is never captured."/>

                    <TextBlock Text="ANSWERS" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Answer model" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ModelBox" Grid.Column="1" Style="{StaticResource Combo}" IsEditable="True" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Text="Transcription model" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SttBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource Combo}" IsEditable="True" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Text="Realtime protocol" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ProtocolBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Text="Font size" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FontBox" Grid.Row="3" Grid.Column="1" Style="{StaticResource Combo}" Margin="0,3"/>
                    </Grid>
                    <CheckBox x:Name="FastCacheBox" Style="{StaticResource Check}" Content="Show prepared answers instantly when the question clearly matches" Margin="0,10,0,0"/>

                    <TextBlock Text="LISTENING" Style="{StaticResource Section}"/>
                    <TextBlock Text="End-of-question wait" Style="{StaticResource T.Body}"/>
                    <DockPanel Margin="0,4,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="Faster" FontSize="11" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" Width="46"/>
                        <TextBlock DockPanel.Dock="Right" Text="Waits longer" FontSize="11" Foreground="{StaticResource B.TextFaint}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <Slider x:Name="VadSlider" Minimum="0.6" Maximum="1.8" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Increase if answers appear before the interviewer finishes multi-part questions."/>

                    <TextBlock Text="WINDOW" Style="{StaticResource Section}"/>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Opacity" Style="{StaticResource T.Body}" VerticalAlignment="Center" Width="150"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.6" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    </DockPanel>
                    <CheckBox x:Name="TopmostBox" Style="{StaticResource Check}" Content="Always on top" Margin="0,8,0,0"/>

                    <TextBlock Text="HOTKEYS" Style="{StaticResource Section}"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Text="Show / hide" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="HkToggle" Grid.Column="1" Style="{StaticResource Input}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Text="Start / pause" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="HkStart" Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Text="Type a question" Style="{StaticResource T.Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="HkManual" Grid.Row="2" Grid.Column="1" Style="{StaticResource Input}" Margin="0,3"/>
                    </Grid>

                    <TextBlock Text="PRIVACY" Style="{StaticResource Section}"/>
                    <CheckBox x:Name="SaveTranscriptBox" Style="{StaticResource Check}" Content="Save questions and answers to Documents when I press Stop"/>
                    <TextBlock Style="{StaticResource Hint}" Text="Off by default. Raw audio is never saved; only short in-memory buffers are used."/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
