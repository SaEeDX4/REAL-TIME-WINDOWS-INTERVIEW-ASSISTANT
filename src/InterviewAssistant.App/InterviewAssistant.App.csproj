<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>InterviewAssistant</AssemblyName>
    <RootNamespace>InterviewAssistant.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <!-- Velopack hooks must run before WPF starts: custom entry point. -->
    <StartupObject>InterviewAssistant.App.Program</StartupObject>
    <Product>Interview Assistant</Product>
    <Company>Interview Assistant</Company>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\InterviewAssistant.Core\InterviewAssistant.Core.csproj" />
    <ProjectReference Include="..\InterviewAssistant.Client\InterviewAssistant.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\knowledge\**\*" LinkBase="knowledge" CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
</Project>
